@page
@model TourManagement.Web.Pages.Tours.EditModel
@{
    ViewData["Title"] = "Edit Tour";
}

<h1>Edit Tour</h1>

@if (Model.Tour != null)
{
    <div class="row">
        <div class="col-md-8">
            <form method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Tour.Id" />
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Tour.TourName" class="form-label"></label>
                    <input asp-for="Tour.TourName" class="form-control" required />
                    <span asp-validation-for="Tour.TourName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Tour.Place" class="form-label"></label>
                    <input asp-for="Tour.Place" class="form-control" required />
                    <span asp-validation-for="Tour.Place" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Tour.Days" class="form-label"></label>
                    <input asp-for="Tour.Days" class="form-control" type="number" required />
                    <span asp-validation-for="Tour.Days" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Tour.Price" class="form-label"></label>
                    <input asp-for="Tour.Price" class="form-control" type="number" step="0.01" required />
                    <span asp-validation-for="Tour.Price" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Tour.Locations" class="form-label"></label>
                    <input asp-for="Tour.Locations" class="form-control" required />
                    <span asp-validation-for="Tour.Locations" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Tour.TourInfo" class="form-label"></label>
                    <textarea asp-for="Tour.TourInfo" class="form-control" rows="4" maxlength="250" required></textarea>
                    <span asp-validation-for="Tour.TourInfo" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <div class="form-check">
                        <input asp-for="Tour.IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="Tour.IsActive" class="form-check-label"></label>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="ImageFile" class="form-label">Tour Image (leave empty to keep current)</label>
                    <input asp-for="ImageFile" class="form-control" type="file" accept="image/*" />
                    @if (!string.IsNullOrEmpty(Model.Tour.PictureFileName))
                    {
                        <small class="form-text text-muted">Current image: @Model.Tour.PictureFileName</small>
                    }
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
                </div>
            </form>
        </div>
    </div>
}
else
{
    <p class="alert alert-warning">Tour not found.</p>
    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
