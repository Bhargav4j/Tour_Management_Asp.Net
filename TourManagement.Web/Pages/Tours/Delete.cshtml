@page
@model TourManagement.Web.Pages.Tours.DeleteModel
@{
    ViewData["Title"] = "Delete Tour";
}

<h1>Delete Tour</h1>

<h3>Are you sure you want to delete this tour?</h3>

@if (Model.Tour != null)
{
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                @if (!string.IsNullOrEmpty(Model.Tour.PictureFileName))
                {
                    <img src="~/uploads/@Model.Tour.PictureFileName" class="card-img-top" alt="@Model.Tour.TourName">
                }
                <div class="card-body">
                    <h4 class="card-title">@Model.Tour.TourName</h4>
                    <hr />
                    <dl class="row">
                        <dt class="col-sm-3">Place</dt>
                        <dd class="col-sm-9">@Model.Tour.Place</dd>

                        <dt class="col-sm-3">Days</dt>
                        <dd class="col-sm-9">@Model.Tour.Days</dd>

                        <dt class="col-sm-3">Price</dt>
                        <dd class="col-sm-9">$@Model.Tour.Price</dd>

                        <dt class="col-sm-3">Locations</dt>
                        <dd class="col-sm-9">@Model.Tour.Locations</dd>

                        <dt class="col-sm-3">Tour Information</dt>
                        <dd class="col-sm-9">@Model.Tour.TourInfo</dd>
                    </dl>

                    <form method="post">
                        <input type="hidden" asp-for="Tour.Id" />
                        <div class="mt-3">
                            <button type="submit" class="btn btn-danger">Delete</button>
                            <a asp-page="Index" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <p class="alert alert-warning">Tour not found.</p>
    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
}
