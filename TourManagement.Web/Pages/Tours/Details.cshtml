@page
@model TourManagement.Web.Pages.Tours.DetailsModel
@{
    ViewData["Title"] = "Tour Details";
}

<h1>Tour Details</h1>

@if (Model.Tour != null)
{
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                @if (!string.IsNullOrEmpty(Model.Tour.PictureFileName))
                {
                    <img src="~/uploads/@Model.Tour.PictureFileName" class="card-img-top" alt="@Model.Tour.TourName">
                }
                <div class="card-body">
                    <h3 class="card-title">@Model.Tour.TourName</h3>
                    <hr />
                    <dl class="row">
                        <dt class="col-sm-3">Place</dt>
                        <dd class="col-sm-9">@Model.Tour.Place</dd>

                        <dt class="col-sm-3">Days</dt>
                        <dd class="col-sm-9">@Model.Tour.Days days</dd>

                        <dt class="col-sm-3">Price</dt>
                        <dd class="col-sm-9">$@Model.Tour.Price</dd>

                        <dt class="col-sm-3">Locations</dt>
                        <dd class="col-sm-9">@Model.Tour.Locations</dd>

                        <dt class="col-sm-3">Tour Information</dt>
                        <dd class="col-sm-9">@Model.Tour.TourInfo</dd>

                        <dt class="col-sm-3">Status</dt>
                        <dd class="col-sm-9">
                            @if (Model.Tour.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </dd>
                    </dl>

                    <div class="mt-3">
                        <a asp-page="Edit" asp-route-id="@Model.Tour.Id" class="btn btn-warning">Edit</a>
                        <a asp-page="Index" class="btn btn-secondary">Back to List</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <p class="alert alert-warning">Tour not found.</p>
    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
}
