@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Tour Management</h1>
    <p>Discover amazing tours and book your next adventure!</p>
    <p>
        <a asp-page="/Tours/Index" class="btn btn-primary btn-lg">Browse Tours</a>
    </p>
</div>

<div class="row mt-5">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Explore Tours</h5>
                <p class="card-text">Browse through our collection of exciting tours and destinations.</p>
                <a asp-page="/Tours/Index" class="btn btn-primary">View Tours</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Easy Booking</h5>
                <p class="card-text">Simple and secure booking process for your convenience.</p>
                <a asp-page="/Account/Register" class="btn btn-primary">Register Now</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Manage Bookings</h5>
                <p class="card-text">Track and manage all your tour bookings in one place.</p>
                <a asp-page="/Account/Login" class="btn btn-primary">Login</a>
            </div>
        </div>
    </div>
</div>
