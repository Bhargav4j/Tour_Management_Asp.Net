@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Tour Management</h1>
    <p>Manage your tours, bookings, and customers efficiently.</p>

    <div class="row mt-5">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Tours</h5>
                    <p class="card-text">Manage tour packages, destinations, and pricing.</p>
                    <a asp-page="/Tours/Index" class="btn btn-primary">View Tours</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Bookings</h5>
                    <p class="card-text">Track and manage customer bookings.</p>
                    <a asp-page="/Bookings/Index" class="btn btn-primary">View Bookings</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Users</h5>
                    <p class="card-text">Manage user accounts and profiles.</p>
                    <a asp-page="/Users/Index" class="btn btn-primary">View Users</a>
                </div>
            </div>
        </div>
    </div>
</div>
