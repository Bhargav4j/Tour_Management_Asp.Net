@page
@model CreateTourModel
@{
    ViewData["Title"] = "Create Tour";
}

<div class="container">
    <h2>Create New Tour</h2>
    <hr />

    <form method="post">
        <div class="mb-3">
            <label asp-for="Input.TourName" class="form-label">Tour Name</label>
            <input asp-for="Input.TourName" class="form-control" required />
            <span asp-validation-for="Input.TourName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.Description" class="form-label">Description</label>
            <textarea asp-for="Input.Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Input.Description" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Input.Place" class="form-label">Place</label>
                <input asp-for="Input.Place" class="form-control" required />
                <span asp-validation-for="Input.Place" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Input.Price" class="form-label">Price</label>
                <input asp-for="Input.Price" class="form-control" type="number" step="0.01" required />
                <span asp-validation-for="Input.Price" class="text-danger"></span>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Input.Duration" class="form-label">Duration (days)</label>
                <input asp-for="Input.Duration" class="form-control" type="number" required />
                <span asp-validation-for="Input.Duration" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Input.ImageUrl" class="form-label">Image URL</label>
                <input asp-for="Input.ImageUrl" class="form-control" />
                <span asp-validation-for="Input.ImageUrl" class="text-danger"></span>
            </div>
        </div>
        <div class="d-grid gap-2 d-md-flex">
            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-page="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
