@page
@model TourManagement.Web.Pages.Tours.DetailsModel
@{
    ViewData["Title"] = "Tour Details";
}

<h1>Tour Details</h1>

@if (Model.Tour != null)
{
    <div>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">Tour Name</dt>
            <dd class="col-sm-10">@Model.Tour.TourName</dd>

            <dt class="col-sm-2">Place</dt>
            <dd class="col-sm-10">@Model.Tour.Place</dd>

            <dt class="col-sm-2">Days</dt>
            <dd class="col-sm-10">@Model.Tour.Days</dd>

            <dt class="col-sm-2">Price</dt>
            <dd class="col-sm-10">$@Model.Tour.Price</dd>

            <dt class="col-sm-2">Locations</dt>
            <dd class="col-sm-10">@Model.Tour.Locations</dd>

            <dt class="col-sm-2">Tour Information</dt>
            <dd class="col-sm-10">@Model.Tour.TourInfo</dd>

            @if (!string.IsNullOrEmpty(Model.Tour.PicturePath))
            {
                <dt class="col-sm-2">Picture</dt>
                <dd class="col-sm-10">
                    <img src="~/images/tours/@Model.Tour.PicturePath" alt="@Model.Tour.TourName" style="max-width: 500px;" />
                </dd>
            }
        </dl>
    </div>
    <div>
        <a asp-page="Edit" asp-route-id="@Model.Tour.Id" class="btn btn-warning">Edit</a>
        <a asp-page="Index" class="btn btn-secondary">Back to List</a>
    </div>
}
else
{
    <p>Tour not found.</p>
    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
}
