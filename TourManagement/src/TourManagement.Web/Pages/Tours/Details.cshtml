@page
@model TourManagement.Web.Pages.Tours.DetailsModel
@{
    ViewData["Title"] = "Tour Details";
}

<h1>Tour Details</h1>

<div>
    <hr />
    @if (Model.Tour != null)
    {
        <div class="row">
            <div class="col-md-6">
                @if (!string.IsNullOrEmpty(Model.Tour.PicturePath))
                {
                    <img src="~/images/tours/@Model.Tour.PicturePath" class="img-fluid" alt="@Model.Tour.TourName" />
                }
                else
                {
                    <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 300px;">
                        <span>No Image</span>
                    </div>
                }
            </div>
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-4">Tour Name</dt>
                    <dd class="col-sm-8">@Model.Tour.TourName</dd>

                    <dt class="col-sm-4">Place</dt>
                    <dd class="col-sm-8">@Model.Tour.Place</dd>

                    <dt class="col-sm-4">Days</dt>
                    <dd class="col-sm-8">@Model.Tour.Days</dd>

                    <dt class="col-sm-4">Price</dt>
                    <dd class="col-sm-8">$@Model.Tour.Price</dd>

                    <dt class="col-sm-4">Locations</dt>
                    <dd class="col-sm-8">@Model.Tour.Locations</dd>

                    <dt class="col-sm-4">Tour Info</dt>
                    <dd class="col-sm-8">@Model.Tour.TourInfo</dd>

                    <dt class="col-sm-4">Created Date</dt>
                    <dd class="col-sm-8">@Model.Tour.CreatedDate.ToString("yyyy-MM-dd")</dd>
                </dl>

                <div class="mt-3">
                    <a asp-page="Edit" asp-route-id="@Model.Tour.Id" class="btn btn-warning">Edit</a>
                    <a asp-page="Delete" asp-route-id="@Model.Tour.Id" class="btn btn-danger">Delete</a>
                    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
                    <a asp-page="/Bookings/Create" asp-route-tourId="@Model.Tour.Id" class="btn btn-success">Book Now</a>
                </div>
            </div>
        </div>
    }
    else
    {
        <p class="alert alert-warning">Tour not found.</p>
        <a asp-page="Index" class="btn btn-secondary">Back to List</a>
    }
</div>
