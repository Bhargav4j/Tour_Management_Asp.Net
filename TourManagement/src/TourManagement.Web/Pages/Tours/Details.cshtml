@page
@model TourManagement.Web.Pages.Tours.DetailsModel
@{
    ViewData["Title"] = "Tour Details";
}

<h1>Tour Details</h1>

@if (Model.Tour != null)
{
    <div class="card">
        @if (!string.IsNullOrEmpty(Model.Tour.ImageFileName))
        {
            <img src="~/images/tours/@Model.Tour.ImageFileName" class="card-img-top" alt="@Model.Tour.TourName" style="max-height: 400px; object-fit: cover;" />
        }
        <div class="card-body">
            <h2 class="card-title">@Model.Tour.TourName</h2>
            <hr />
            <dl class="row">
                <dt class="col-sm-3">Place</dt>
                <dd class="col-sm-9">@Model.Tour.Place</dd>

                <dt class="col-sm-3">Duration</dt>
                <dd class="col-sm-9">@Model.Tour.Days days</dd>

                <dt class="col-sm-3">Price</dt>
                <dd class="col-sm-9">$@Model.Tour.Price.ToString("N2")</dd>

                <dt class="col-sm-3">Locations</dt>
                <dd class="col-sm-9">@Model.Tour.Locations</dd>

                <dt class="col-sm-3">Tour Information</dt>
                <dd class="col-sm-9">@Model.Tour.TourInfo</dd>

                <dt class="col-sm-3">Created Date</dt>
                <dd class="col-sm-9">@Model.Tour.CreatedDate.ToString("yyyy-MM-dd")</dd>
            </dl>
        </div>
        <div class="card-footer">
            <div class="btn-group" role="group">
                <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
                <a asp-page="/Bookings/Create" asp-route-tourId="@Model.Tour.Id" class="btn btn-success">Book This Tour</a>
                @if (Model.IsAdmin)
                {
                    <a asp-page="./Edit" asp-route-id="@Model.Tour.Id" class="btn btn-warning">Edit</a>
                    <a asp-page="./Delete" asp-route-id="@Model.Tour.Id" class="btn btn-danger">Delete</a>
                }
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">Tour not found.</div>
    <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
}
