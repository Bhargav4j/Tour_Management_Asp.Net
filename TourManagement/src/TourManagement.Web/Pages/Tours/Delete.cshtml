@page
@model TourManagement.Web.Pages.Tours.DeleteModel
@{
    ViewData["Title"] = "Delete Tour";
}

<h1>Delete Tour</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <hr />
    @if (Model.Tour != null)
    {
        <dl class="row">
            <dt class="col-sm-2">Tour Name</dt>
            <dd class="col-sm-10">@Model.Tour.TourName</dd>

            <dt class="col-sm-2">Place</dt>
            <dd class="col-sm-10">@Model.Tour.Place</dd>

            <dt class="col-sm-2">Days</dt>
            <dd class="col-sm-10">@Model.Tour.Days</dd>

            <dt class="col-sm-2">Price</dt>
            <dd class="col-sm-10">$@Model.Tour.Price</dd>

            <dt class="col-sm-2">Locations</dt>
            <dd class="col-sm-10">@Model.Tour.Locations</dd>
        </dl>

        <form method="post">
            <input type="hidden" asp-for="Tour.Id" />
            <input type="submit" value="Delete" class="btn btn-danger" />
            <a asp-page="Index" class="btn btn-secondary">Back to List</a>
        </form>
    }
    else
    {
        <p>Tour not found.</p>
        <a asp-page="Index" class="btn btn-secondary">Back to List</a>
    }
</div>
