@page
@model TourManagement.Web.Pages.Tours.DeleteModel
@{
    ViewData["Title"] = "Delete Tour";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <h1>Delete Tour</h1>
        <hr />

        <h3 class="text-danger">Are you sure you want to delete this tour?</h3>

        @if (Model.Tour == null)
        {
            <div class="alert alert-warning">Tour not found.</div>
        }
        else
        {
            <div class="card">
                @if (!string.IsNullOrEmpty(Model.Tour.PictureUrl))
                {
                    <img src="@Model.Tour.PictureUrl" class="card-img-top" alt="@Model.Tour.Name" style="max-height: 300px; object-fit: cover;">
                }
                <div class="card-body">
                    <h5 class="card-title">@Model.Tour.Name</h5>
                    <dl class="row">
                        <dt class="col-sm-3">Place</dt>
                        <dd class="col-sm-9">@Model.Tour.Place</dd>

                        <dt class="col-sm-3">Days</dt>
                        <dd class="col-sm-9">@Model.Tour.Days</dd>

                        <dt class="col-sm-3">Price</dt>
                        <dd class="col-sm-9">@Model.Tour.Price.ToString("C")</dd>

                        <dt class="col-sm-3">Locations</dt>
                        <dd class="col-sm-9">@Model.Tour.Locations</dd>
                    </dl>
                </div>
            </div>

            <form method="post" class="mt-3">
                <input type="hidden" asp-for="Tour.Id" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-page="Index" class="btn btn-secondary">Cancel</a>
            </form>
        }
    </div>
</div>
