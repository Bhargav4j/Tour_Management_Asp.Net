@page
@model TourManagement.Web.Pages.Tours.EditModel
@{
    ViewData["Title"] = "Edit Tour";
}

<h1>Edit Tour</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="TourInput.Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="TourInput.TourName" class="control-label"></label>
                <input asp-for="TourInput.TourName" class="form-control" />
                <span asp-validation-for="TourInput.TourName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TourInput.Place" class="control-label"></label>
                <input asp-for="TourInput.Place" class="form-control" />
                <span asp-validation-for="TourInput.Place" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TourInput.Days" class="control-label"></label>
                <input asp-for="TourInput.Days" class="form-control" />
                <span asp-validation-for="TourInput.Days" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TourInput.Price" class="control-label"></label>
                <input asp-for="TourInput.Price" class="form-control" />
                <span asp-validation-for="TourInput.Price" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TourInput.Locations" class="control-label"></label>
                <input asp-for="TourInput.Locations" class="form-control" />
                <span asp-validation-for="TourInput.Locations" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TourInput.TourInfo" class="control-label"></label>
                <textarea asp-for="TourInput.TourInfo" class="form-control" rows="4"></textarea>
                <span asp-validation-for="TourInput.TourInfo" class="text-danger"></span>
            </div>

            @if (!string.IsNullOrEmpty(Model.TourInput.ExistingPicturePath))
            {
                <div class="form-group mb-3">
                    <label>Current Picture</label><br />
                    <img src="~/images/tours/@Model.TourInput.ExistingPicturePath" alt="Current" style="max-width: 200px;" />
                </div>
            }

            <div class="form-group mb-3">
                <label asp-for="TourInput.Picture" class="control-label"></label>
                <input asp-for="TourInput.Picture" type="file" class="form-control" accept=".jpg,.jpeg,.png,.gif" />
                <span asp-validation-for="TourInput.Picture" class="text-danger"></span>
                <small class="form-text text-muted">Leave empty to keep current picture</small>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-page="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
