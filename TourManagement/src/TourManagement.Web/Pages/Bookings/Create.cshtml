@page
@model TourManagement.Web.Pages.Bookings.CreateModel
@{
    ViewData["Title"] = "Create Booking";
}

<h1>Create New Booking</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="BookingInput.UserId" class="control-label"></label>
                <select asp-for="BookingInput.UserId" class="form-control" asp-items="Model.UserList">
                    <option value="">Select User</option>
                </select>
                <span asp-validation-for="BookingInput.UserId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="BookingInput.TourId" class="control-label"></label>
                <select asp-for="BookingInput.TourId" class="form-control" asp-items="Model.TourList">
                    <option value="">Select Tour</option>
                </select>
                <span asp-validation-for="BookingInput.TourId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="BookingInput.NumberOfPeople" class="control-label"></label>
                <input asp-for="BookingInput.NumberOfPeople" class="form-control" />
                <span asp-validation-for="BookingInput.NumberOfPeople" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="BookingInput.TotalAmount" class="control-label"></label>
                <input asp-for="BookingInput.TotalAmount" class="form-control" />
                <span asp-validation-for="BookingInput.TotalAmount" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="BookingInput.BookingStatus" class="control-label"></label>
                <select asp-for="BookingInput.BookingStatus" class="form-control">
                    <option value="Pending">Pending</option>
                    <option value="Confirmed">Confirmed</option>
                    <option value="Cancelled">Cancelled</option>
                    <option value="Completed">Completed</option>
                </select>
                <span asp-validation-for="BookingInput.BookingStatus" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-page="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
