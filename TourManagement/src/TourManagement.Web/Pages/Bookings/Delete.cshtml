@page
@model TourManagement.Web.Pages.Bookings.DeleteModel
@{
    ViewData["Title"] = "Delete Booking";
}

<h1>Delete Booking</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <hr />
    @if (Model.Booking != null)
    {
        <dl class="row">
            <dt class="col-sm-2">Booking ID</dt>
            <dd class="col-sm-10">@Model.Booking.Id</dd>

            <dt class="col-sm-2">User</dt>
            <dd class="col-sm-10">@Model.Booking.User.FirstName @Model.Booking.User.LastName</dd>

            <dt class="col-sm-2">Tour</dt>
            <dd class="col-sm-10">@Model.Booking.Tour.TourName</dd>

            <dt class="col-sm-2">Total Amount</dt>
            <dd class="col-sm-10">$@Model.Booking.TotalAmount</dd>

            <dt class="col-sm-2">Status</dt>
            <dd class="col-sm-10">@Model.Booking.BookingStatus</dd>
        </dl>

        <form method="post">
            <input type="hidden" asp-for="Booking.Id" />
            <input type="submit" value="Delete" class="btn btn-danger" />
            <a asp-page="Index" class="btn btn-secondary">Back to List</a>
        </form>
    }
    else
    {
        <p>Booking not found.</p>
        <a asp-page="Index" class="btn btn-secondary">Back to List</a>
    }
</div>
