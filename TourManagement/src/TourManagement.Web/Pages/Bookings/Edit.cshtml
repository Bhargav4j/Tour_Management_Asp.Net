@page
@model TourManagement.Web.Pages.Bookings.EditModel
@{
    ViewData["Title"] = "Edit Booking";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h1>Edit Booking</h1>
            <hr />

            @if (Model.Booking == null)
            {
                <div class="alert alert-warning">Booking not found.</div>
            }
            else
            {
                <form method="post" class="needs-validation" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <input type="hidden" asp-for="Booking.Id" />

                    <div class="mb-3">
                        <label asp-for="Booking.UserId" class="form-label"></label>
                        <select asp-for="Booking.UserId" class="form-select" asp-items="Model.Users">
                            <option value="">Select User</option>
                        </select>
                        <span asp-validation-for="Booking.UserId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Booking.TourId" class="form-label"></label>
                        <select asp-for="Booking.TourId" class="form-select" asp-items="Model.Tours">
                            <option value="">Select Tour</option>
                        </select>
                        <span asp-validation-for="Booking.TourId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Booking.BookingDate" class="form-label"></label>
                        <input asp-for="Booking.BookingDate" class="form-control" type="date" />
                        <span asp-validation-for="Booking.BookingDate" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Booking.NumberOfPersons" class="form-label"></label>
                        <input asp-for="Booking.NumberOfPersons" class="form-control" type="number" min="1" />
                        <span asp-validation-for="Booking.NumberOfPersons" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Booking.TotalAmount" class="form-label"></label>
                        <input asp-for="Booking.TotalAmount" class="form-control" type="number" step="0.01" min="0" />
                        <span asp-validation-for="Booking.TotalAmount" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            <input asp-for="Booking.IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="Booking.IsActive" class="form-check-label"></label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                        <a asp-page="Index" class="btn btn-secondary">Back to List</a>
                    </div>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
