@page
@model BookingsIndexModel
@{
    ViewData["Title"] = "Bookings";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Bookings</h2>
        <a asp-page="Create" class="btn btn-primary">Create New Booking</a>
    </div>

    @if (Model.Bookings != null && Model.Bookings.Any())
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Booking ID</th>
                    <th>Tour Name</th>
                    <th>Place</th>
                    <th>Customer Name</th>
                    <th>Email</th>
                    <th>Booking Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model.Bookings)
                {
                    <tr>
                        <td>@booking.Id</td>
                        <td>@booking.TourName</td>
                        <td>@booking.Place</td>
                        <td>@booking.FirstName</td>
                        <td>@booking.Email</td>
                        <td>@booking.BookingDate.ToShortDateString()</td>
                        <td>
                            <span class="badge bg-@(booking.Status == "Confirmed" ? "success" : booking.Status == "Pending" ? "warning" : "danger")">
                                @booking.Status
                            </span>
                        </td>
                        <td>
                            <a asp-page="Details" asp-route-id="@booking.Id" class="btn btn-info btn-sm">Details</a>
                            <a asp-page="Delete" asp-route-id="@booking.Id" class="btn btn-danger btn-sm">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">No bookings found.</div>
    }
</div>
