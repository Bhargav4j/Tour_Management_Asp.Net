@page
@model UsersIndexModel
@{
    ViewData["Title"] = "Users";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Users</h2>
    </div>

    @if (Model.Users != null && Model.Users.Any())
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Gender</th>
                    <th>City</th>
                    <th>State</th>
                    <th>Admin</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>@user.Id</td>
                        <td>@user.FirstName @user.LastName</td>
                        <td>@user.Email</td>
                        <td>@user.Gender</td>
                        <td>@user.City</td>
                        <td>@user.State</td>
                        <td>
                            @if (user.IsAdmin)
                            {
                                <span class="badge bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No</span>
                            }
                        </td>
                        <td>
                            <a asp-page="Details" asp-route-id="@user.Id" class="btn btn-info btn-sm">Details</a>
                            <a asp-page="Edit" asp-route-id="@user.Id" class="btn btn-warning btn-sm">Edit</a>
                            <a asp-page="Delete" asp-route-id="@user.Id" class="btn btn-danger btn-sm">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">No users found.</div>
    }
</div>
