@page
@model TourManagement.Web.Pages.Users.DeleteModel
@{
    ViewData["Title"] = "Delete User";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h1>Delete User</h1>
            <hr />

            @if (Model.User == null)
            {
                <div class="alert alert-warning">User not found.</div>
            }
            else
            {
                <div class="alert alert-danger">
                    <h4>Are you sure you want to delete this user?</h4>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h4>@Model.User.Name</h4>
                    </div>
                    <div class="card-body">
                        <dl class="row">
                            <dt class="col-sm-3">ID</dt>
                            <dd class="col-sm-9">@Model.User.Id</dd>

                            <dt class="col-sm-3">Name</dt>
                            <dd class="col-sm-9">@Model.User.Name</dd>

                            <dt class="col-sm-3">Email</dt>
                            <dd class="col-sm-9">@Model.User.Email</dd>

                            <dt class="col-sm-3">Phone</dt>
                            <dd class="col-sm-9">@Model.User.Phone</dd>

                            <dt class="col-sm-3">Role</dt>
                            <dd class="col-sm-9">
                                <span class="badge bg-@(Model.User.Role == "Admin" ? "danger" : "primary")">
                                    @Model.User.Role
                                </span>
                            </dd>

                            <dt class="col-sm-3">Created Date</dt>
                            <dd class="col-sm-9">@Model.User.CreatedDate.ToString("yyyy-MM-dd")</dd>
                        </dl>
                    </div>
                </div>

                <form method="post" class="mt-3">
                    <input type="hidden" asp-for="User.Id" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
                </form>
            }
        </div>
    </div>
</div>
