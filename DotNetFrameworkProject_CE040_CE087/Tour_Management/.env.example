# Cloud-Ready Environment Configuration for Tour Management Application
# Copy this file to .env and update with your actual values

# Database Configuration (AWS RDS recommended)
DB_CONNECTION_STRING=Data Source=your-rds-instance.region.rds.amazonaws.com,1433;Initial Catalog=TourManagement;User ID=dbuser;Password=your-secure-password;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;

# File Upload Configuration (AWS S3 or EFS recommended)
UPLOAD_PATH=/var/app/uploads
# For S3: Configure S3 bucket and use S3 SDK for uploads

# Chart Image Storage Configuration
CHART_TEMP_DIR=/tmp/charts

# Admin Credentials (Use AWS Secrets Manager in production)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=YourSecureAdminPassword123!

# Application Settings
ASPNETCORE_ENVIRONMENT=Production
PORT=8080

# AWS Configuration (if using AWS services)
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-tour-management-bucket

# Logging Configuration
LOG_LEVEL=Information
