@page
@model TourManagement.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container">
    <h1>Admin Dashboard</h1>
    <hr />

    <div class="row">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Manage Tours</h5>
                    <p class="card-text">Add, edit, or delete tours</p>
                    <a asp-page="/Tours/Index" class="btn btn-primary">Manage Tours</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">View Bookings</h5>
                    <p class="card-text">View all bookings</p>
                    <a asp-page="./AllBookings" class="btn btn-primary">View All Bookings</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Manage Users</h5>
                    <p class="card-text">View and manage users</p>
                    <a asp-page="./Users" class="btn btn-primary">Manage Users</a>
                </div>
            </div>
        </div>
    </div>
</div>
