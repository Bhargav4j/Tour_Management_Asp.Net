@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Tour Management</h1>
    <p class="lead">Discover amazing travel destinations and book your next adventure</p>
    <div class="mt-4">
        <a asp-page="/Tours/Index" class="btn btn-primary btn-lg me-2">Browse Tours</a>
        <a asp-page="/Account/Register" class="btn btn-outline-secondary btn-lg">Sign Up</a>
    </div>
</div>

<div class="row mt-5">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Explore Destinations</h5>
                <p class="card-text">Browse through our curated collection of tour packages to exciting destinations worldwide.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Easy Booking</h5>
                <p class="card-text">Simple and secure booking process to reserve your dream vacation in just a few clicks.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Manage Bookings</h5>
                <p class="card-text">View and manage all your bookings from one convenient location.</p>
            </div>
        </div>
    </div>
</div>
