@page
@model CreateTourPageModel
@{
    ViewData["Title"] = "Add New Tour";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <h2 class="card-title text-center">Add New Tour</h2>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }

                <form method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label asp-for="Input.TourName" class="form-label">Tour Name</label>
                        <input asp-for="Input.TourName" class="form-control" />
                        <span asp-validation-for="Input.TourName" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.Place" class="form-label">Place</label>
                            <input asp-for="Input.Place" class="form-control" />
                            <span asp-validation-for="Input.Place" class="text-danger"></span>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="Input.Days" class="form-label">Days</label>
                            <input asp-for="Input.Days" class="form-control" type="number" />
                            <span asp-validation-for="Input.Days" class="text-danger"></span>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="Input.Price" class="form-label">Price</label>
                            <input asp-for="Input.Price" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="Input.Price" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Locations" class="form-label">Locations</label>
                        <input asp-for="Input.Locations" class="form-control" />
                        <span asp-validation-for="Input.Locations" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.TourInfo" class="form-label">Tour Information</label>
                        <textarea asp-for="Input.TourInfo" class="form-control" rows="5"></textarea>
                        <span asp-validation-for="Input.TourInfo" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.PictureFile" class="form-label">Picture</label>
                        <input asp-for="Input.PictureFile" class="form-control" type="file" accept="image/*" />
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success">Add Tour</button>
                        <a asp-page="/Tours/Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
