@page
@model ToursIndexPageModel
@{
    ViewData["Title"] = "Browse Tours";
}

<div class="container">
    <div class="row">
        <div class="col-md-12">
            <h2>Available Tours</h2>
            <div class="mb-3">
                <a asp-page="/Tours/Create" class="btn btn-success">Add New Tour</a>
            </div>
        </div>
    </div>

    @if (Model.Tours != null && Model.Tours.Any())
    {
        <div class="row">
            @foreach (var tour in Model.Tours)
            {
                <div class="col-md-4 mb-4">
                    <div class="card">
                        @if (!string.IsNullOrEmpty(tour.PictureFileName))
                        {
                            <img src="~/uploads/tour-pictures/@tour.PictureFileName" class="card-img-top" alt="@tour.TourName" style="height: 200px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                                <span class="text-white">No Image</span>
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title">@tour.TourName</h5>
                            <p class="card-text"><strong>Place:</strong> @tour.Place</p>
                            <p class="card-text"><strong>Duration:</strong> @tour.Days days</p>
                            <p class="card-text"><strong>Price:</strong> $@tour.Price.ToString("N2")</p>
                            <p class="card-text">@tour.TourInfo.Substring(0, Math.Min(100, tour.TourInfo.Length))...</p>
                            <div class="d-grid gap-2">
                                <a asp-page="/Tours/Details" asp-route-id="@tour.Id" class="btn btn-primary">View Details</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">No tours available at this time.</div>
    }
</div>
