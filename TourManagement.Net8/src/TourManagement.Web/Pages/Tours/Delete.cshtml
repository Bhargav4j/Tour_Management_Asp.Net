@page
@model TourManagement.Web.Pages.Tours.DeleteModel
@{
    ViewData["Title"] = "Delete Tour";
}

<div class="container">
    <h1>Delete Tour</h1>
    <hr />

    <h3 class="text-danger">Are you sure you want to delete this tour?</h3>

    @if (Model.Tour != null)
    {
        <div class="row">
            <div class="col-md-6">
                @if (!string.IsNullOrEmpty(Model.Tour.PicturePath))
                {
                    <img src="~/Tour_pics/@Model.Tour.PicturePath" class="img-fluid" alt="@Model.Tour.TourName" />
                }
            </div>
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-4">Tour Name</dt>
                    <dd class="col-sm-8">@Model.Tour.TourName</dd>

                    <dt class="col-sm-4">Place</dt>
                    <dd class="col-sm-8">@Model.Tour.Place</dd>

                    <dt class="col-sm-4">Days</dt>
                    <dd class="col-sm-8">@Model.Tour.Days</dd>

                    <dt class="col-sm-4">Price</dt>
                    <dd class="col-sm-8">$@Model.Tour.Price.ToString("N2")</dd>

                    <dt class="col-sm-4">Locations</dt>
                    <dd class="col-sm-8">@Model.Tour.Locations</dd>
                </dl>
            </div>
        </div>

        <form method="post">
            <input type="hidden" asp-for="Tour!.Id" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
        </form>
    }
    else
    {
        <div class="alert alert-warning">Tour not found.</div>
        <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
    }
</div>
