@page "{id:int}"
@model TourManagement.Web.Pages.Tours.EditModel
@{
    ViewData["Title"] = "Edit Tour";
}

<h1>Edit Tour</h1>

@if (Model.TourInput != null)
{
    <div class="row">
        <div class="col-md-8">
            <form method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="TourInput.Id" />
                <div class="form-group mb-3">
                    <label asp-for="TourInput.TourName" class="form-label"></label>
                    <input asp-for="TourInput.TourName" class="form-control" />
                    <span asp-validation-for="TourInput.TourName" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="TourInput.Place" class="form-label"></label>
                    <input asp-for="TourInput.Place" class="form-control" />
                    <span asp-validation-for="TourInput.Place" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="TourInput.Days" class="form-label"></label>
                    <input asp-for="TourInput.Days" class="form-control" type="number" />
                    <span asp-validation-for="TourInput.Days" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="TourInput.Price" class="form-label"></label>
                    <input asp-for="TourInput.Price" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="TourInput.Price" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="TourInput.Locations" class="form-label"></label>
                    <input asp-for="TourInput.Locations" class="form-control" />
                    <span asp-validation-for="TourInput.Locations" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="TourInput.TourInfo" class="form-label"></label>
                    <textarea asp-for="TourInput.TourInfo" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="TourInput.TourInfo" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label class="form-label">Current Picture</label>
                    @if (!string.IsNullOrEmpty(Model.TourInput.CurrentPictureFileName))
                    {
                        <div>
                            <img src="~/images/tours/@Model.TourInput.CurrentPictureFileName" alt="Current" style="max-width: 200px;" />
                        </div>
                    }
                </div>
                <div class="form-group mb-3">
                    <label asp-for="PictureFile" class="form-label">New Picture (optional)</label>
                    <input asp-for="PictureFile" class="form-control" type="file" accept="image/*" />
                    <span asp-validation-for="PictureFile" class="text-danger"></span>
                </div>
                <div class="form-check mb-3">
                    <input asp-for="TourInput.IsActive" class="form-check-input" />
                    <label asp-for="TourInput.IsActive" class="form-check-label"></label>
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
