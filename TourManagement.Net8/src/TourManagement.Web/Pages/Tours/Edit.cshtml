@page
@model TourManagement.Web.Pages.Tours.EditModel
@{
    ViewData["Title"] = "Edit Tour";
}

<div class="container">
    <h1>Edit Tour</h1>
    <hr />

    <form method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CurrentPicturePath" />

        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="TourName" class="form-label">Tour Name</label>
                    <input asp-for="TourName" class="form-control" />
                    <span asp-validation-for="TourName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Place" class="form-label">Place</label>
                    <input asp-for="Place" class="form-control" />
                    <span asp-validation-for="Place" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Days" class="form-label">Days</label>
                    <input asp-for="Days" type="number" class="form-control" />
                    <span asp-validation-for="Days" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Price" class="form-label">Price</label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Locations" class="form-label">Locations</label>
                    <textarea asp-for="Locations" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Locations" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TourInfo" class="form-label">Tour Information</label>
                    <textarea asp-for="TourInfo" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="TourInfo" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PictureFile" class="form-label">Change Picture (optional)</label>
                    <input asp-for="PictureFile" type="file" class="form-control" accept="image/*" />
                    <span asp-validation-for="PictureFile" class="text-danger"></span>
                    @if (!string.IsNullOrEmpty(Model.CurrentPicturePath))
                    {
                        <small class="form-text text-muted">Current: @Model.CurrentPicturePath</small>
                    }
                </div>
            </div>
        </div>

        <div class="mb-3">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
