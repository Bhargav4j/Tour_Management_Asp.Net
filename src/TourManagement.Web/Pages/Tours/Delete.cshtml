@page "{id:int}"
@model TourManagement.Web.Pages.Tours.DeleteModel
@{
    ViewData["Title"] = "Delete Tour";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="display-4 text-danger">Delete Tour</h1>
            <hr />
        </div>
    </div>

    @if (Model.Tour == null)
    {
        <div class="alert alert-warning">
            <h4>Tour Not Found</h4>
            <p>The tour you are trying to delete does not exist or has already been removed.</p>
            <a asp-page="./Index" class="btn btn-primary">Back to Tours</a>
        </div>
    }
    else
    {
        <div class="alert alert-danger" role="alert">
            <h4 class="alert-heading">
                <i class="bi bi-exclamation-triangle"></i> Warning!
            </h4>
            <p>Are you sure you want to delete this tour? This action cannot be undone.</p>
            <hr>
            <p class="mb-0">All associated data including bookings (if any) may be affected.</p>
        </div>

        <div class="row">
            <div class="col-md-8">
                <div class="card shadow-sm">
                    @if (!string.IsNullOrEmpty(Model.Tour.PictureFileName))
                    {
                        <img src="~/images/tours/@Model.Tour.PictureFileName" class="card-img-top" alt="@Model.Tour.TourName" style="max-height: 300px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                            <span class="text-white fs-4">No Image</span>
                        </div>
                    }
                    <div class="card-body">
                        <h3 class="card-title">@Model.Tour.TourName</h3>
                        <p class="card-text">
                            <span class="badge @(Model.Tour.IsActive ? "bg-success" : "bg-danger") fs-6">
                                @(Model.Tour.IsActive ? "Active" : "Inactive")
                            </span>
                        </p>
                        <hr />

                        <div class="row mb-2">
                            <div class="col-md-4">
                                <strong>Place:</strong>
                            </div>
                            <div class="col-md-8">
                                @Model.Tour.Place
                            </div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-md-4">
                                <strong>Duration:</strong>
                            </div>
                            <div class="col-md-8">
                                @Model.Tour.Days Day@(Model.Tour.Days > 1 ? "s" : "")
                            </div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-md-4">
                                <strong>Price:</strong>
                            </div>
                            <div class="col-md-8">
                                <span class="text-success fw-bold">@Model.Tour.Price.ToString("C")</span>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.Tour.Locations))
                        {
                            <div class="row mb-2">
                                <div class="col-md-4">
                                    <strong>Locations:</strong>
                                </div>
                                <div class="col-md-8">
                                    @Model.Tour.Locations
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(Model.Tour.TourInfo))
                        {
                            <div class="row mb-2">
                                <div class="col-md-4">
                                    <strong>Description:</strong>
                                </div>
                                <div class="col-md-8">
                                    @if (Model.Tour.TourInfo.Length > 200)
                                    {
                                        @Model.Tour.TourInfo.Substring(0, 200)<text>...</text>
                                    }
                                    else
                                    {
                                        @Model.Tour.TourInfo
                                    }
                                </div>
                            </div>
                        }

                        <hr />

                        <div class="row mb-2">
                            <div class="col-md-4">
                                <strong>Created:</strong>
                            </div>
                            <div class="col-md-8">
                                @Model.Tour.CreatedDate.ToLocalTime().ToString("MMM dd, yyyy") by @Model.Tour.CreatedBy
                            </div>
                        </div>

                        @if (Model.Tour.ModifiedDate.HasValue)
                        {
                            <div class="row mb-2">
                                <div class="col-md-4">
                                    <strong>Last Modified:</strong>
                                </div>
                                <div class="col-md-8">
                                    @Model.Tour.ModifiedDate.Value.ToLocalTime().ToString("MMM dd, yyyy") by @Model.Tour.ModifiedBy
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="mt-4">
                    <form method="post">
                        <input type="hidden" asp-for="Tour.Id" />
                        <button type="submit" class="btn btn-danger btn-lg" onclick="return confirm('Are you absolutely sure you want to delete this tour? This action cannot be undone.');">
                            <i class="bi bi-trash"></i> Confirm Delete
                        </button>
                        <a asp-page="./Details" asp-route-id="@Model.Tour.Id" class="btn btn-info btn-lg">
                            <i class="bi bi-eye"></i> View Details
                        </a>
                        <a asp-page="./Index" class="btn btn-secondary btn-lg">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                    </form>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-danger shadow-sm">
                    <div class="card-header bg-danger text-white">
                        <h5 class="mb-0">Delete Confirmation</h5>
                    </div>
                    <div class="card-body">
                        <h6 class="card-title">What will be deleted?</h6>
                        <ul class="small">
                            <li>Tour: <strong>@Model.Tour.TourName</strong></li>
                            <li>Tour ID: <strong>@Model.Tour.Id</strong></li>
                            @if (!string.IsNullOrEmpty(Model.Tour.PictureFileName))
                            {
                                <li>Associated image file</li>
                            }
                            <li>All tour metadata</li>
                        </ul>
                        <hr />
                        <h6 class="card-title">Before you proceed:</h6>
                        <ul class="small text-muted">
                            <li>Make sure there are no active bookings</li>
                            <li>Consider deactivating instead of deleting</li>
                            <li>Ensure you have proper authorization</li>
                            <li>This action cannot be reversed</li>
                        </ul>
                        <hr />
                        <p class="card-text small">
                            <strong>Alternative:</strong> Instead of deleting, you can
                            <a asp-page="./Edit" asp-route-id="@Model.Tour.Id">edit this tour</a>
                            and mark it as inactive to hide it from customers while preserving the data.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Additional confirmation on form submit
        document.querySelector('form').addEventListener('submit', function(e) {
            const confirmed = confirm('FINAL CONFIRMATION: Are you absolutely certain you want to permanently delete this tour?');
            if (!confirmed) {
                e.preventDefault();
            }
        });
    </script>
}
