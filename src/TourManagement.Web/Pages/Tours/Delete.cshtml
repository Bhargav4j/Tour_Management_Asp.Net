@page
@model TourManagement.Web.Pages.Tours.DeleteModel
@{
    ViewData["Title"] = "Delete Tour";
}

<div class="container">
    <h1>Delete Tour</h1>
    <h3 class="text-danger">Are you sure you want to delete this tour?</h3>

    @if (Model.Tour != null)
    {
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">@Model.Tour.TourName</h5>
                @if (!string.IsNullOrEmpty(Model.Tour.PicturePath))
                {
                    <img src="@Model.Tour.PicturePath" alt="@Model.Tour.TourName" class="img-fluid mb-3" style="max-height: 300px;" />
                }
                <dl class="row">
                    <dt class="col-sm-3">Place</dt>
                    <dd class="col-sm-9">@Model.Tour.Place</dd>

                    <dt class="col-sm-3">Days</dt>
                    <dd class="col-sm-9">@Model.Tour.Days</dd>

                    <dt class="col-sm-3">Price</dt>
                    <dd class="col-sm-9">@Model.Tour.Price.ToString("C")</dd>
                </dl>

                <form method="post">
                    <input type="hidden" asp-for="Tour.Id" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">Tour not found.</div>
        <a asp-page="Index" class="btn btn-secondary">Back to List</a>
    }
</div>
