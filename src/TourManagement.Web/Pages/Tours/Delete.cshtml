@page "{id:int}"
@model TourManagement.Web.Pages.Tours.DeleteModel
@{
    ViewData["Title"] = "Delete Tour";
}

<h2>Delete Tour</h2>
<hr />

<h3>Are you sure you want to delete this tour?</h3>

@if (Model.Tour != null)
{
    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Tour Name:</dt>
                <dd class="col-sm-9">@Model.Tour.TourName</dd>

                <dt class="col-sm-3">Place:</dt>
                <dd class="col-sm-9">@Model.Tour.Place</dd>

                <dt class="col-sm-3">Days:</dt>
                <dd class="col-sm-9">@Model.Tour.Days</dd>

                <dt class="col-sm-3">Price:</dt>
                <dd class="col-sm-9">$@Model.Tour.Price.ToString("N2")</dd>

                <dt class="col-sm-3">Locations:</dt>
                <dd class="col-sm-9">@Model.Tour.Locations</dd>
            </dl>
        </div>
    </div>

    <form method="post" class="mt-3">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="/Tours/Index" class="btn btn-secondary">Cancel</a>
    </form>
}
else
{
    <div class="alert alert-warning">
        Tour not found.
    </div>
    <a asp-page="/Tours/Index" class="btn btn-secondary">Back to List</a>
}
