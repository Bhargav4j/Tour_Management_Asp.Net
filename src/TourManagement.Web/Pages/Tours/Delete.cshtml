@page
@model TourDeleteModel
@{
    ViewData["Title"] = "Delete Tour";
}

<h2>Delete Tour</h2>

<div class="alert alert-warning">
    <h4>Are you sure you want to delete this tour?</h4>
</div>

@if (Model.Tour != null)
{
    <div class="card">
        @if (!string.IsNullOrEmpty(Model.Tour.PicturePath))
        {
            <img src="~/Tour_pics/@Model.Tour.PicturePath" class="card-img-top" alt="@Model.Tour.TourName" style="max-height: 300px; object-fit: cover;" />
        }
        <div class="card-body">
            <h3 class="card-title">@Model.Tour.TourName</h3>
            <p><strong>Place:</strong> @Model.Tour.Place</p>
            <p><strong>Days:</strong> @Model.Tour.Days</p>
            <p><strong>Price:</strong> $@Model.Tour.Price.ToString("N2")</p>
            <p><strong>Locations:</strong> @Model.Tour.Locations</p>
            <p><strong>Tour Information:</strong> @Model.Tour.TourInfo</p>
        </div>
    </div>

    <form method="post" class="mt-3">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <a asp-page="/Tours/Index" class="btn btn-secondary">Cancel</a>
    </form>
}
else
{
    <div class="alert alert-danger">Tour not found.</div>
    <a asp-page="/Tours/Index" class="btn btn-secondary">Back to List</a>
}
