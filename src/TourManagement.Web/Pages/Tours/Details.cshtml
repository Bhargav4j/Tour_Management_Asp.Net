@page "{id:int}"
@model TourManagement.Web.Pages.Tours.DetailsModel
@{
    ViewData["Title"] = "Tour Details";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="display-4">Tour Details</h1>
            <hr />
        </div>
    </div>

    @if (Model.Tour == null)
    {
        <div class="alert alert-warning">
            <h4>Tour Not Found</h4>
            <p>The tour you are looking for does not exist or has been removed.</p>
            <a asp-page="./Index" class="btn btn-primary">Back to Tours</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card shadow-sm mb-4">
                    @if (!string.IsNullOrEmpty(Model.Tour.PictureFileName))
                    {
                        <img src="~/images/tours/@Model.Tour.PictureFileName" class="card-img-top" alt="@Model.Tour.TourName" style="max-height: 400px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 300px;">
                            <span class="text-white display-6">No Image Available</span>
                        </div>
                    }
                    <div class="card-body">
                        <h2 class="card-title">@Model.Tour.TourName</h2>
                        <p class="card-text">
                            <span class="badge @(Model.Tour.IsActive ? "bg-success" : "bg-danger") fs-6">
                                @(Model.Tour.IsActive ? "Active" : "Inactive")
                            </span>
                        </p>
                        <hr />

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <h5>Place</h5>
                                <p class="lead">@Model.Tour.Place</p>
                            </div>
                            <div class="col-md-6">
                                <h5>Duration</h5>
                                <p class="lead">@Model.Tour.Days Day@(Model.Tour.Days > 1 ? "s" : "")</p>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12">
                                <h5>Price</h5>
                                <p class="lead text-success fw-bold">@Model.Tour.Price.ToString("C")</p>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.Tour.Locations))
                        {
                            <div class="row mb-3">
                                <div class="col-md-12">
                                    <h5>Key Locations</h5>
                                    <p>@Model.Tour.Locations</p>
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(Model.Tour.TourInfo))
                        {
                            <div class="row mb-3">
                                <div class="col-md-12">
                                    <h5>Tour Information</h5>
                                    <p class="text-justify">@Model.Tour.TourInfo</p>
                                </div>
                            </div>
                        }

                        <hr />

                        <div class="row mb-3">
                            <div class="col-md-12">
                                <h6 class="text-muted">Tour Details</h6>
                                <table class="table table-sm">
                                    <tbody>
                                        <tr>
                                            <th scope="row" style="width: 30%;">Tour ID</th>
                                            <td>@Model.Tour.Id</td>
                                        </tr>
                                        <tr>
                                            <th scope="row">Created Date</th>
                                            <td>@Model.Tour.CreatedDate.ToLocalTime().ToString("MMMM dd, yyyy hh:mm tt")</td>
                                        </tr>
                                        <tr>
                                            <th scope="row">Created By</th>
                                            <td>@Model.Tour.CreatedBy</td>
                                        </tr>
                                        @if (Model.Tour.ModifiedDate.HasValue)
                                        {
                                            <tr>
                                                <th scope="row">Last Modified</th>
                                                <td>@Model.Tour.ModifiedDate.Value.ToLocalTime().ToString("MMMM dd, yyyy hh:mm tt")</td>
                                            </tr>
                                        }
                                        @if (!string.IsNullOrEmpty(Model.Tour.ModifiedBy))
                                        {
                                            <tr>
                                                <th scope="row">Modified By</th>
                                                <td>@Model.Tour.ModifiedBy</td>
                                            </tr>
                                        }
                                        <tr>
                                            <th scope="row">Status</th>
                                            <td>
                                                <span class="badge @(Model.Tour.IsActive ? "bg-success" : "bg-danger")">
                                                    @(Model.Tour.IsActive ? "Active" : "Inactive")
                                                </span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <a asp-page="./Edit" asp-route-id="@Model.Tour.Id" class="btn btn-primary">
                        <i class="bi bi-pencil"></i> Edit Tour
                    </a>
                    <a asp-page="./Delete" asp-route-id="@Model.Tour.Id" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Delete Tour
                    </a>
                    <a asp-page="./Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card bg-light shadow-sm mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Quick Actions</h5>
                        <div class="d-grid gap-2">
                            <a asp-page="./Edit" asp-route-id="@Model.Tour.Id" class="btn btn-outline-primary">
                                Edit This Tour
                            </a>
                            <a asp-page="./Create" class="btn btn-outline-success">
                                Create Similar Tour
                            </a>
                            <a asp-page="/Bookings/Create" asp-route-tourId="@Model.Tour.Id" class="btn btn-outline-info">
                                Book This Tour
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card bg-light shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Tour Statistics</h5>
                        <ul class="list-unstyled">
                            <li><strong>Duration:</strong> @Model.Tour.Days day@(Model.Tour.Days > 1 ? "s" : "")</li>
                            <li><strong>Price per person:</strong> @Model.Tour.Price.ToString("C")</li>
                            <li><strong>Total for family (4):</strong> @((Model.Tour.Price * 4).ToString("C"))</li>
                        </ul>
                        <hr />
                        <p class="small text-muted mb-0">
                            <strong>Note:</strong> Prices are subject to change. Please contact us for the most current rates and availability.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Optional: Add any interactive features like image zoom, etc.
    </script>
}
