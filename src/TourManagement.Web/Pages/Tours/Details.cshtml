@page
@model TourManagement.Web.Pages.Tours.DetailsModel
@{
    ViewData["Title"] = "Tour Details";
}

<h2>Tour Details</h2>

@if (Model.Tour != null)
{
    <div class="card">
        @if (!string.IsNullOrEmpty(Model.Tour.PicFileName))
        {
            <img src="~/uploads/tours/@Model.Tour.PicFileName" class="card-img-top" alt="@Model.Tour.TourName" />
        }
        <div class="card-body">
            <h5 class="card-title">@Model.Tour.TourName</h5>
            <p class="card-text"><strong>Place:</strong> @Model.Tour.Place</p>
            <p class="card-text"><strong>Duration:</strong> @Model.Tour.Days days</p>
            <p class="card-text"><strong>Price:</strong> $@Model.Tour.Price</p>
            <p class="card-text"><strong>Locations:</strong> @Model.Tour.Locations</p>
            <p class="card-text"><strong>Description:</strong> @Model.Tour.TourInfo</p>
        </div>
    </div>
    <div class="mt-3">
        <a asp-page="/Tours/Edit" asp-route-id="@Model.Tour.TourId" class="btn btn-warning">Edit</a>
        <a asp-page="/Tours/Delete" asp-route-id="@Model.Tour.TourId" class="btn btn-danger">Delete</a>
        <a asp-page="/Tours/Index" class="btn btn-secondary">Back to List</a>
    </div>
}
else
{
    <p>Tour not found.</p>
}
