@page "{id:int}"
@model TourManagement.Web.Pages.Tours.DetailsModel
@{
    ViewData["Title"] = "Tour Details";
}

<h1>@ViewData["Title"]</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Tour?.Name</dd>

        <dt class="col-sm-2">Place</dt>
        <dd class="col-sm-10">@Model.Tour?.Place</dd>

        <dt class="col-sm-2">Days</dt>
        <dd class="col-sm-10">@Model.Tour?.Days</dd>

        <dt class="col-sm-2">Price</dt>
        <dd class="col-sm-10">$@Model.Tour?.Price</dd>

        <dt class="col-sm-2">Locations</dt>
        <dd class="col-sm-10">@Model.Tour?.Locations</dd>

        <dt class="col-sm-2">Tour Info</dt>
        <dd class="col-sm-10">@Model.Tour?.TourInfo</dd>

        @if (!string.IsNullOrEmpty(Model.Tour?.PicturePath))
        {
            <dt class="col-sm-2">Picture</dt>
            <dd class="col-sm-10">
                <img src="~/images/@Model.Tour.PicturePath" alt="@Model.Tour.Name" class="img-fluid" style="max-width: 400px;" />
            </dd>
        }
    </dl>
</div>
<div>
    <a asp-page="Edit" asp-route-id="@Model.Tour?.Id" class="btn btn-primary">Edit</a>
    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
    <a asp-page="/Bookings/Create" asp-route-tourId="@Model.Tour?.Id" class="btn btn-success">Book Now</a>
</div>
