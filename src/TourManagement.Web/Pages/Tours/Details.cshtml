@page
@model TourDetailsModel
@{
    ViewData["Title"] = "Tour Details";
}

<h2>Tour Details</h2>

@if (Model.Tour != null)
{
    <div class="card">
        @if (!string.IsNullOrEmpty(Model.Tour.ImageFileName))
        {
            <img src="~/uploads/tours/@Model.Tour.ImageFileName" class="card-img-top" alt="@Model.Tour.TourName" />
        }
        <div class="card-body">
            <h5 class="card-title">@Model.Tour.TourName</h5>
            <dl class="row">
                <dt class="col-sm-3">Place</dt>
                <dd class="col-sm-9">@Model.Tour.Place</dd>

                <dt class="col-sm-3">Days</dt>
                <dd class="col-sm-9">@Model.Tour.Days</dd>

                <dt class="col-sm-3">Price</dt>
                <dd class="col-sm-9">$@Model.Tour.Price.ToString("N2")</dd>

                <dt class="col-sm-3">Locations</dt>
                <dd class="col-sm-9">@Model.Tour.Locations</dd>

                <dt class="col-sm-3">Tour Information</dt>
                <dd class="col-sm-9">@Model.Tour.TourInfo</dd>
            </dl>
        </div>
        <div class="card-footer">
            <a asp-page="/Tours/Edit" asp-route-id="@Model.Tour.TourId" class="btn btn-warning">Edit</a>
            <a asp-page="/Tours/Delete" asp-route-id="@Model.Tour.TourId" class="btn btn-danger">Delete</a>
            <a asp-page="/Bookings/Create" asp-route-tourId="@Model.Tour.TourId" class="btn btn-success">Book Now</a>
            <a asp-page="/Tours/Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">Tour not found.</div>
}
