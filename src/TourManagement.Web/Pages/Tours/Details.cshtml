@page "{id:int}"
@model TourManagement.Web.Pages.Tours.DetailsModel
@{
    ViewData["Title"] = "Tour Details";
}

<h1>Tour Details</h1>

@if (Model.Tour != null)
{
    <div class="card">
        <div class="card-body">
            <h2 class="card-title">@Model.Tour.TourName</h2>

            @if (!string.IsNullOrEmpty(Model.Tour.PicturePath))
            {
                <img src="~/images/@Model.Tour.PicturePath" alt="@Model.Tour.TourName" class="img-fluid mb-3" style="max-height: 400px;" />
            }

            <dl class="row">
                <dt class="col-sm-3">Place</dt>
                <dd class="col-sm-9">@Model.Tour.Place</dd>

                <dt class="col-sm-3">Duration</dt>
                <dd class="col-sm-9">@Model.Tour.Days days</dd>

                <dt class="col-sm-3">Price</dt>
                <dd class="col-sm-9">$@Model.Tour.Price</dd>

                <dt class="col-sm-3">Locations</dt>
                <dd class="col-sm-9">@Model.Tour.Locations</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Tour.TourInfo</dd>
            </dl>

            <div class="mt-3">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-page="/Bookings/Create" asp-route-tourId="@Model.Tour.TourId" class="btn btn-success">Book Now</a>
                }
                else
                {
                    <a asp-page="/Account/Login" asp-route-returnUrl="@($"/Tours/Details/{Model.Tour.TourId}")" class="btn btn-success">Login to Book</a>
                }
                <a asp-page="/Tours/Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">Tour not found.</div>
    <a asp-page="/Tours/Index" class="btn btn-secondary">Back to List</a>
}
