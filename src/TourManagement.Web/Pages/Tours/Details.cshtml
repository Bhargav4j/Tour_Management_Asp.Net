@page "{id:int}"
@model DetailsModel
@{
    ViewData["Title"] = "Tour Details";
}

<h2>@ViewData["Title"]</h2>

@if (Model.Tour == null)
{
    <div class="alert alert-warning">Tour not found.</div>
    <a asp-page="/Tours/Index" class="btn btn-secondary">Back to Tours</a>
}
else
{
    <div class="card">
        @if (!string.IsNullOrEmpty(Model.Tour.Pic))
        {
            <img src="~/images/tours/@Model.Tour.Pic" class="card-img-top" alt="@Model.Tour.TourName" style="max-height: 400px; object-fit: cover;" />
        }
        <div class="card-body">
            <h3 class="card-title">@Model.Tour.TourName</h3>
            <hr />
            <dl class="row">
                <dt class="col-sm-3">Place</dt>
                <dd class="col-sm-9">@Model.Tour.Place</dd>

                <dt class="col-sm-3">Duration</dt>
                <dd class="col-sm-9">@Model.Tour.Days days</dd>

                <dt class="col-sm-3">Price</dt>
                <dd class="col-sm-9">$@Model.Tour.Price.ToString("N2")</dd>

                <dt class="col-sm-3">Locations</dt>
                <dd class="col-sm-9">@Model.Tour.Locations</dd>

                <dt class="col-sm-3">Tour Information</dt>
                <dd class="col-sm-9">@Model.Tour.TourInfo</dd>
            </dl>
        </div>
        <div class="card-footer">
            <a asp-page="/Bookings/Create" asp-route-tourId="@Model.Tour.TourId" class="btn btn-success">Book This Tour</a>
            <a asp-page="/Tours/Index" class="btn btn-secondary">Back to Tours</a>
        </div>
    </div>
}
