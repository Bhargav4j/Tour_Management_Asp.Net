@page "{id:int}"
@model TourManagement.Web.Pages.Tours.DetailsModel
@{
    ViewData["Title"] = "Tour Details";
}

<h2>Tour Details</h2>
<hr />

@if (Model.Tour != null)
{
    <div class="row">
        <div class="col-md-6">
            @if (!string.IsNullOrEmpty(Model.Tour.PicturePath))
            {
                <img src="~/uploads/@Model.Tour.PicturePath" class="img-fluid" alt="@Model.Tour.TourName">
            }
            else
            {
                <div class="bg-secondary d-flex align-items-center justify-content-center" style="height: 300px;">
                    <span class="text-white">No Image Available</span>
                </div>
            }
        </div>
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Tour Name:</dt>
                <dd class="col-sm-8">@Model.Tour.TourName</dd>

                <dt class="col-sm-4">Place:</dt>
                <dd class="col-sm-8">@Model.Tour.Place</dd>

                <dt class="col-sm-4">Days:</dt>
                <dd class="col-sm-8">@Model.Tour.Days</dd>

                <dt class="col-sm-4">Price:</dt>
                <dd class="col-sm-8">$@Model.Tour.Price.ToString("N2")</dd>

                <dt class="col-sm-4">Locations:</dt>
                <dd class="col-sm-8">@Model.Tour.Locations</dd>

                <dt class="col-sm-4">Tour Info:</dt>
                <dd class="col-sm-8">@Model.Tour.TourInfo</dd>
            </dl>

            <div class="mt-3">
                <a asp-page="/Tours/Edit" asp-route-id="@Model.Tour.Id" class="btn btn-warning">Edit</a>
                <a asp-page="/Tours/Delete" asp-route-id="@Model.Tour.Id" class="btn btn-danger">Delete</a>
                <a asp-page="/Tours/Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">
        Tour not found.
    </div>
    <a asp-page="/Tours/Index" class="btn btn-secondary">Back to List</a>
}
