@page "{id:int}"
@model TourManagement.Web.Pages.Tours.EditModel
@{
    ViewData["Title"] = "Edit Tour";
}

<h1>@ViewData["Title"]</h1>

<hr />
<div class="row">
    <div class="col-md-8">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="TourInput.Id" />

            <div class="form-group mb-3">
                <label asp-for="TourInput.Name" class="control-label"></label>
                <input asp-for="TourInput.Name" class="form-control" />
                <span asp-validation-for="TourInput.Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TourInput.Place" class="control-label"></label>
                <input asp-for="TourInput.Place" class="form-control" />
                <span asp-validation-for="TourInput.Place" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TourInput.Days" class="control-label"></label>
                <input asp-for="TourInput.Days" class="form-control" type="number" />
                <span asp-validation-for="TourInput.Days" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TourInput.Price" class="control-label"></label>
                <input asp-for="TourInput.Price" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="TourInput.Price" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TourInput.Locations" class="control-label"></label>
                <input asp-for="TourInput.Locations" class="form-control" />
                <span asp-validation-for="TourInput.Locations" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TourInput.TourInfo" class="control-label"></label>
                <textarea asp-for="TourInput.TourInfo" class="form-control" rows="4" maxlength="250"></textarea>
                <span asp-validation-for="TourInput.TourInfo" class="text-danger"></span>
                <small class="form-text text-muted">Maximum 250 characters</small>
            </div>

            @if (!string.IsNullOrEmpty(Model.TourInput.CurrentPicturePath))
            {
                <div class="form-group mb-3">
                    <label>Current Picture</label><br />
                    <img src="~/images/@Model.TourInput.CurrentPicturePath" alt="Current" style="max-width: 200px;" />
                </div>
            }

            <div class="form-group mb-3">
                <label asp-for="TourInput.PictureFile" class="control-label"></label>
                <input asp-for="TourInput.PictureFile" class="form-control" type="file" accept="image/*" />
                <span asp-validation-for="TourInput.PictureFile" class="text-danger"></span>
                <small class="form-text text-muted">Leave empty to keep current picture</small>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-page="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
