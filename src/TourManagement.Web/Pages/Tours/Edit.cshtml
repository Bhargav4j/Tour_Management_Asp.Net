@page "{id:int}"
@model TourManagement.Web.Pages.Tours.EditModel
@{
    ViewData["Title"] = "Edit Tour";
}

<h2>Edit Tour</h2>
<hr />

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        @Model.ErrorMessage
    </div>
}

@if (Model.Tour != null)
{
    <form method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="TourId" />

        <div class="form-group mb-3">
            <label asp-for="TourName" class="form-label"></label>
            <input asp-for="TourName" class="form-control" />
            <span asp-validation-for="TourName" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Place" class="form-label"></label>
            <input asp-for="Place" class="form-control" />
            <span asp-validation-for="Place" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label asp-for="Days" class="form-label"></label>
                    <input asp-for="Days" type="number" class="form-control" />
                    <span asp-validation-for="Days" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label asp-for="Price" class="form-label"></label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Locations" class="form-label"></label>
            <input asp-for="Locations" class="form-control" />
            <span asp-validation-for="Locations" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="TourInfo" class="form-label"></label>
            <textarea asp-for="TourInfo" class="form-control" rows="4"></textarea>
            <span asp-validation-for="TourInfo" class="text-danger"></span>
        </div>

        @if (!string.IsNullOrEmpty(Model.CurrentPicturePath))
        {
            <div class="form-group mb-3">
                <label>Current Picture:</label><br />
                <img src="~/uploads/@Model.CurrentPicturePath" alt="Current picture" style="max-width: 200px;" />
            </div>
        }

        <div class="form-group mb-3">
            <label asp-for="PictureFile" class="form-label"></label>
            <input asp-for="PictureFile" type="file" class="form-control" accept="image/*" />
            <span asp-validation-for="PictureFile" class="text-danger"></span>
            <small class="form-text text-muted">Leave empty to keep current picture</small>
        </div>

        <div class="form-group mb-3">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-page="/Tours/Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
}
else
{
    <div class="alert alert-warning">
        Tour not found.
    </div>
    <a asp-page="/Tours/Index" class="btn btn-secondary">Back to List</a>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
