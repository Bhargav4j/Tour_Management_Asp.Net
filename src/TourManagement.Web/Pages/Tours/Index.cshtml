@page
@model TourManagement.Web.Pages.Tours.IndexModel
@{
    ViewData["Title"] = "Tours";
}

<h2>Available Tours</h2>

<div class="mb-3">
    <a asp-page="/Tours/Create" class="btn btn-primary">Add New Tour</a>
</div>

@if (Model.Tours != null && Model.Tours.Any())
{
    <div class="row">
        @foreach (var tour in Model.Tours)
        {
            <div class="col-md-4 mb-4">
                <div class="card">
                    @if (!string.IsNullOrEmpty(tour.PicFileName))
                    {
                        <img src="~/uploads/tours/@tour.PicFileName" class="card-img-top" alt="@tour.TourName" style="height: 200px; object-fit: cover;" />
                    }
                    <div class="card-body">
                        <h5 class="card-title">@tour.TourName</h5>
                        <p class="card-text">@tour.Place</p>
                        <p class="card-text"><small>@tour.Days days - $@tour.Price</small></p>
                        <p class="card-text">@tour.TourInfo</p>
                        <div class="btn-group" role="group">
                            <a asp-page="/Tours/Details" asp-route-id="@tour.TourId" class="btn btn-sm btn-info">Details</a>
                            <a asp-page="/Tours/Edit" asp-route-id="@tour.TourId" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-page="/Tours/Delete" asp-route-id="@tour.TourId" class="btn btn-sm btn-danger">Delete</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p>No tours available.</p>
}
