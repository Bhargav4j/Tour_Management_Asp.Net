@page
@model TourManagement.Web.Pages.Tours.IndexModel
@{
    ViewData["Title"] = "Tours";
}

<h1>Available Tours</h1>

@if (Model.Tours != null && Model.Tours.Any())
{
    <div class="row">
        @foreach (var tour in Model.Tours)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(tour.Picture))
                    {
                        <img src="~/Tour_pics/@tour.Picture" class="card-img-top" alt="@tour.TourName" style="height: 200px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary" style="height: 200px;"></div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@tour.TourName</h5>
                        <p class="card-text">
                            <strong>Price:</strong> $@tour.Price<br />
                            <strong>Duration:</strong> @tour.Days days<br />
                            @if (!string.IsNullOrEmpty(tour.Locations))
                            {
                                <strong>Locations:</strong> @tour.Locations<br />
                            }
                        </p>
                        @if (!string.IsNullOrEmpty(tour.Description))
                        {
                            <p class="card-text"><small>@tour.Description</small></p>
                        }
                    </div>
                    <div class="card-footer">
                        <a asp-page="./Details" asp-route-id="@tour.TourId" class="btn btn-primary btn-sm">View Details</a>
                        <a asp-page="/Bookings/Create" asp-route-tourId="@tour.TourId" class="btn btn-success btn-sm">Book Now</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">
        No tours available at the moment. Please check back later.
    </div>
}
