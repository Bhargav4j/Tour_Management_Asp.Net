@page
@model TourManagement.Web.Pages.Tours.IndexModel
@{
    ViewData["Title"] = "Tours";
}

<h2>Available Tours</h2>
<hr />

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        @Model.ErrorMessage
    </div>
}

<div class="mb-3">
    <a asp-page="/Tours/Create" class="btn btn-success">Add New Tour</a>
</div>

@if (Model.Tours != null && Model.Tours.Any())
{
    <div class="row">
        @foreach (var tour in Model.Tours)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(tour.PicturePath))
                    {
                        <img src="~/uploads/@tour.PicturePath" class="card-img-top" alt="@tour.TourName" style="height: 200px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                            <span class="text-white">No Image</span>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@tour.TourName</h5>
                        <p class="card-text"><strong>Place:</strong> @tour.Place</p>
                        <p class="card-text"><strong>Days:</strong> @tour.Days</p>
                        <p class="card-text"><strong>Price:</strong> $@tour.Price.ToString("N2")</p>
                        <p class="card-text"><small>@tour.TourInfo</small></p>
                    </div>
                    <div class="card-footer">
                        <a asp-page="/Tours/Details" asp-route-id="@tour.Id" class="btn btn-primary btn-sm">Details</a>
                        <a asp-page="/Tours/Edit" asp-route-id="@tour.Id" class="btn btn-warning btn-sm">Edit</a>
                        <a asp-page="/Tours/Delete" asp-route-id="@tour.Id" class="btn btn-danger btn-sm">Delete</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">
        No tours available at the moment.
    </div>
}
