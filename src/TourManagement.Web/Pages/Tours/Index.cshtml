@page
@model TourManagement.Web.Pages.Tours.IndexModel
@{
    ViewData["Title"] = "Tours";
}

<h1>Available Tours</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Add New Tour</a>
</p>

<form method="get">
    <div class="row mb-3">
        <div class="col-md-6">
            <input type="text" name="searchString" value="@Model.SearchString" class="form-control" placeholder="Search tours..." />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-secondary">Search</button>
        </div>
    </div>
</form>

@if (Model.Tours != null && Model.Tours.Any())
{
    <div class="row">
        @foreach (var tour in Model.Tours)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(tour.Pic))
                    {
                        <img src="~/images/@tour.Pic" class="card-img-top" alt="@tour.TourName" style="height: 200px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                            <span class="text-white">No Image</span>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@tour.TourName</h5>
                        <p class="card-text">
                            <strong>Place:</strong> @tour.Place<br />
                            <strong>Days:</strong> @tour.Days<br />
                            <strong>Price:</strong> $@tour.Price<br />
                            <strong>Locations:</strong> @tour.Locations
                        </p>
                        <p class="card-text"><small class="text-muted">@tour.TourInfo</small></p>
                    </div>
                    <div class="card-footer">
                        <a asp-page="./Details" asp-route-id="@tour.TourId" class="btn btn-sm btn-info">Details</a>
                        <a asp-page="./Edit" asp-route-id="@tour.TourId" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-page="./Delete" asp-route-id="@tour.TourId" class="btn btn-sm btn-danger">Delete</a>
                        <a asp-page="/Bookings/Create" asp-route-tourId="@tour.TourId" class="btn btn-sm btn-success">Book</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">
        No tours found. <a asp-page="Create" class="alert-link">Create one now</a>
    </div>
}
