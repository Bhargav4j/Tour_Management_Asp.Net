@page
@model TourManagement.Web.Pages.Tours.IndexModel
@{
    ViewData["Title"] = "Tours";
}

<h1>Tours</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Create New Tour</a>
</p>

@if (Model.Tours != null && Model.Tours.Any())
{
    <div class="row">
        @foreach (var tour in Model.Tours)
        {
            <div class="col-md-4 mb-4">
                <div class="card">
                    @if (!string.IsNullOrEmpty(tour.PicFileName))
                    {
                        <img src="~/Tour_pics/@tour.PicFileName" class="card-img-top" alt="@tour.TourName" style="height: 200px; object-fit: cover;" />
                    }
                    <div class="card-body">
                        <h5 class="card-title">@tour.TourName</h5>
                        <p class="card-text">
                            <strong>Place:</strong> @tour.Place<br />
                            <strong>Days:</strong> @tour.Days<br />
                            <strong>Price:</strong> $@tour.Price.ToString("N2")
                        </p>
                        <a asp-page="Details" asp-route-id="@tour.Id" class="btn btn-info">Details</a>
                        <a asp-page="Edit" asp-route-id="@tour.Id" class="btn btn-warning">Edit</a>
                        <a asp-page="Delete" asp-route-id="@tour.Id" class="btn btn-danger">Delete</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p>No tours found.</p>
}
