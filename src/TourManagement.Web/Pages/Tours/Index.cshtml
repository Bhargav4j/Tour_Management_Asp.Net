@page
@model ToursIndexModel
@{
    ViewData["Title"] = "Tours";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Available Tours</h1>
        @if (Model.IsAdmin)
        {
            <a asp-page="/Tours/Create" class="btn btn-success">Add New Tour</a>
        }
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @Model.ErrorMessage
        </div>
    }

    <div class="row">
        @if (Model.Tours != null && Model.Tours.Any())
        {
            @foreach (var tour in Model.Tours)
            {
                <div class="col-md-4 mb-4">
                    <div class="card">
                        @if (!string.IsNullOrEmpty(tour.Pic))
                        {
                            <img src="~/uploads/@tour.Pic" class="card-img-top" alt="@tour.TourName" style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 200px;">
                                <span>No Image</span>
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title">@tour.TourName</h5>
                            <p class="card-text">
                                <strong>Place:</strong> @tour.Place<br />
                                <strong>Days:</strong> @tour.Days<br />
                                <strong>Price:</strong> $@tour.Price<br />
                            </p>
                            <div class="d-flex justify-content-between">
                                <a asp-page="/Tours/Details" asp-route-id="@tour.TourId" class="btn btn-primary">Details</a>
                                @if (Model.IsAdmin)
                                {
                                    <a asp-page="/Tours/Edit" asp-route-id="@tour.TourId" class="btn btn-warning">Edit</a>
                                    <a asp-page="/Tours/Delete" asp-route-id="@tour.TourId" class="btn btn-danger">Delete</a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <p>No tours available at the moment.</p>
        }
    </div>
</div>
