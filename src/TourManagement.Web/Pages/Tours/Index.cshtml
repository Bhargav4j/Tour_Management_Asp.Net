@page
@model TourManagement.Web.Pages.Tours.IndexModel
@{
    ViewData["Title"] = "Tours";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="display-4">Tours</h1>
            <hr />
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row mb-3">
        <div class="col-md-8">
            <form method="get" class="d-flex">
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control me-2" placeholder="Search tours by name, place, or locations..." />
                <button type="submit" class="btn btn-primary me-2">Search</button>
                @if (!string.IsNullOrEmpty(Model.SearchTerm))
                {
                    <a asp-page="./Index" class="btn btn-secondary">Clear</a>
                }
            </form>
        </div>
        <div class="col-md-4 text-end">
            <a asp-page="./Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Create New Tour
            </a>
        </div>
    </div>

    @if (Model.Tours == null || !Model.Tours.Any())
    {
        <div class="alert alert-info">
            @if (!string.IsNullOrEmpty(Model.SearchTerm))
            {
                <p>No tours found matching your search criteria.</p>
            }
            else
            {
                <p>No tours available. <a asp-page="./Create">Create your first tour</a>.</p>
            }
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var tour in Model.Tours)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(tour.PictureFileName))
                        {
                            <img src="~/images/tours/@tour.PictureFileName" class="card-img-top" alt="@tour.TourName" style="height: 200px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                                <span class="text-white">No Image</span>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@tour.TourName</h5>
                            <p class="card-text">
                                <strong>Place:</strong> @tour.Place<br />
                                <strong>Days:</strong> @tour.Days<br />
                                <strong>Price:</strong> @tour.Price.ToString("C")<br />
                                @if (!string.IsNullOrEmpty(tour.Locations))
                                {
                                    <strong>Locations:</strong> @tour.Locations<br />
                                }
                                <span class="badge @(tour.IsActive ? "bg-success" : "bg-danger")">
                                    @(tour.IsActive ? "Active" : "Inactive")
                                </span>
                            </p>
                            @if (!string.IsNullOrEmpty(tour.TourInfo) && tour.TourInfo.Length > 100)
                            {
                                <p class="card-text text-muted small">
                                    @tour.TourInfo.Substring(0, 100)...
                                </p>
                            }
                            else if (!string.IsNullOrEmpty(tour.TourInfo))
                            {
                                <p class="card-text text-muted small">
                                    @tour.TourInfo
                                </p>
                            }
                            <div class="mt-auto">
                                <div class="btn-group w-100" role="group">
                                    <a asp-page="./Details" asp-route-id="@tour.Id" class="btn btn-sm btn-outline-info">Details</a>
                                    <a asp-page="./Edit" asp-route-id="@tour.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                    <a asp-page="./Delete" asp-route-id="@tour.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer text-muted small">
                            Created: @tour.CreatedDate.ToLocalTime().ToString("MMM dd, yyyy")
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        // Auto-dismiss alerts after 5 seconds
        setTimeout(function() {
            var alerts = document.querySelectorAll('.alert');
            alerts.forEach(function(alert) {
                var bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);
    </script>
}
