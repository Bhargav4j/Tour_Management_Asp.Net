@page
@model ToursIndexModel
@{
    ViewData["Title"] = "Tours";
}

<h2>Available Tours</h2>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="row mb-3">
    <div class="col-md-12">
        <a asp-page="/Tours/Create" class="btn btn-primary">Add New Tour</a>
    </div>
</div>

<div class="row">
    @foreach (var tour in Model.Tours)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                @if (!string.IsNullOrEmpty(tour.ImageFileName))
                {
                    <img src="~/uploads/tours/@tour.ImageFileName" class="card-img-top" alt="@tour.TourName" style="height: 200px; object-fit: cover;" />
                }
                else
                {
                    <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                        <span class="text-white">No Image</span>
                    </div>
                }
                <div class="card-body">
                    <h5 class="card-title">@tour.TourName</h5>
                    <p class="card-text">
                        <strong>Place:</strong> @tour.Place<br />
                        <strong>Days:</strong> @tour.Days<br />
                        <strong>Price:</strong> $@tour.Price.ToString("N2")
                    </p>
                    <p class="card-text">@tour.TourInfo</p>
                </div>
                <div class="card-footer">
                    <a asp-page="/Tours/Details" asp-route-id="@tour.TourId" class="btn btn-sm btn-info">Details</a>
                    <a asp-page="/Tours/Edit" asp-route-id="@tour.TourId" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-page="/Bookings/Create" asp-route-tourId="@tour.TourId" class="btn btn-sm btn-success">Book Now</a>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Tours.Any())
{
    <div class="alert alert-info">No tours available at the moment.</div>
}
