@page
@model TourManagement.Web.Pages.Tours.IndexModel
@{
    ViewData["Title"] = "Tours";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-md-12">
            <h1 class="display-4">Tours</h1>
            <hr />
        </div>
    </div>

    @if (!string.IsNullOrEmpty(TempData["SuccessMessage"] as string))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(TempData["ErrorMessage"] as string))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row mb-4">
        <div class="col-md-8">
            <form method="get" class="d-flex">
                <input type="text"
                       class="form-control me-2"
                       name="searchTerm"
                       value="@Model.SearchTerm"
                       placeholder="Search tours by name, place, or location..." />
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i> Search
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                {
                    <a asp-page="./Index" class="btn btn-secondary ms-2">Clear</a>
                }
            </form>
        </div>
        <div class="col-md-4 text-end">
            <a asp-page="./Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Create New Tour
            </a>
        </div>
    </div>

    @if (Model.Tours.Any())
    {
        <div class="row">
            @foreach (var tour in Model.Tours)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(tour.PictureFileName))
                        {
                            <img src="~/images/tours/@tour.PictureFileName"
                                 class="card-img-top"
                                 alt="@tour.TourName"
                                 style="height: 200px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center"
                                 style="height: 200px;">
                                <span class="text-white">No Image</span>
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title">@tour.TourName</h5>
                            <p class="card-text">
                                <strong>Place:</strong> @tour.Place<br />
                                <strong>Duration:</strong> @tour.Days day(s)<br />
                                <strong>Price:</strong> $@tour.Price.ToString("N2")
                            </p>
                            <p class="card-text text-truncate">
                                <small class="text-muted">@tour.TourInfo</small>
                            </p>
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="btn-group" role="group">
                                    <a asp-page="./Details" asp-route-id="@tour.Id" class="btn btn-sm btn-outline-primary">Details</a>
                                    <a asp-page="./Edit" asp-route-id="@tour.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                    <a asp-page="./Delete" asp-route-id="@tour.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                </div>
                                @if (tour.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </div>
                        </div>
                        <div class="card-footer text-muted">
                            <small>Created: @tour.CreatedDate.ToString("MMM dd, yyyy")</small>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
            {
                <p>No tours found matching "<strong>@Model.SearchTerm</strong>".</p>
                <a asp-page="./Index" class="btn btn-sm btn-primary">View All Tours</a>
            }
            else
            {
                <p>No tours available. <a asp-page="./Create">Create your first tour</a> to get started.</p>
            }
        </div>
    }
</div>
