@page
@model ToursIndexModel
@{
    ViewData["Title"] = "Tours";
}

<h2>Available Tours</h2>

@if (Model.Tours != null && Model.Tours.Any())
{
    <div class="row">
        @foreach (var tour in Model.Tours)
        {
            <div class="col-md-4 mb-4">
                <div class="card">
                    @if (!string.IsNullOrEmpty(tour.PictureFileName))
                    {
                        <img src="~/images/tours/@tour.PictureFileName" class="card-img-top" alt="@tour.TourName" style="height: 200px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                            <span class="text-white">No Image</span>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@tour.TourName</h5>
                        <p class="card-text">@tour.Place</p>
                        <p class="card-text"><strong>Days:</strong> @tour.Days</p>
                        <p class="card-text"><strong>Price:</strong> $@tour.Price.ToString("F2")</p>
                        <p class="card-text"><small class="text-muted">@tour.Locations</small></p>
                        <a asp-page="/Tours/Details" asp-route-id="@tour.TourId" class="btn btn-primary">View Details</a>
                        <a asp-page="/Bookings/Create" asp-route-tourId="@tour.TourId" class="btn btn-success">Book Now</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">
        <p>No tours available at this time.</p>
    </div>
}
