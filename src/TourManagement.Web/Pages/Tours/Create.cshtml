@page
@model CreateTourModel
@{
    ViewData["Title"] = "Create Tour";
}

<h2>Create New Tour</h2>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="post" enctype="multipart/form-data">
    <div class="mb-3">
        <label asp-for="TourName" class="form-label"></label>
        <input asp-for="TourName" class="form-control" />
        <span asp-validation-for="TourName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Place" class="form-label"></label>
        <input asp-for="Place" class="form-control" />
        <span asp-validation-for="Place" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Days" class="form-label"></label>
        <input asp-for="Days" class="form-control" type="number" />
        <span asp-validation-for="Days" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Locations" class="form-label"></label>
        <input asp-for="Locations" class="form-control" />
        <span asp-validation-for="Locations" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TourInfo" class="form-label"></label>
        <textarea asp-for="TourInfo" class="form-control" rows="4"></textarea>
        <span asp-validation-for="TourInfo" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ImageFile" class="form-label"></label>
        <input asp-for="ImageFile" class="form-control" type="file" accept="image/*" />
        <span asp-validation-for="ImageFile" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <button type="submit" class="btn btn-primary">Create Tour</button>
        <a asp-page="/Tours/Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
