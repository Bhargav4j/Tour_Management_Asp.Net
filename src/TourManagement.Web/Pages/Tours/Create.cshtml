@page
@model TourManagement.Web.Pages.Tours.CreateModel
@{
    ViewData["Title"] = "Create Tour";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <h1 class="display-4">Create New Tour</h1>
            <hr />
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <form method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Tour.TourName" class="form-label"></label>
                    <input asp-for="Tour.TourName" class="form-control" />
                    <span asp-validation-for="Tour.TourName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Tour.Place" class="form-label"></label>
                    <input asp-for="Tour.Place" class="form-control" />
                    <span asp-validation-for="Tour.Place" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Tour.Days" class="form-label"></label>
                        <input asp-for="Tour.Days" class="form-control" type="number" min="1" />
                        <span asp-validation-for="Tour.Days" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Tour.Price" class="form-label"></label>
                        <input asp-for="Tour.Price" class="form-control" type="number" step="0.01" min="0.01" />
                        <span asp-validation-for="Tour.Price" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Tour.Locations" class="form-label"></label>
                    <input asp-for="Tour.Locations" class="form-control" placeholder="e.g., Paris, London, Rome" />
                    <span asp-validation-for="Tour.Locations" class="text-danger"></span>
                    <small class="form-text text-muted">Enter locations separated by commas</small>
                </div>

                <div class="mb-3">
                    <label asp-for="Tour.TourInfo" class="form-label"></label>
                    <textarea asp-for="Tour.TourInfo" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Tour.TourInfo" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Tour.ImageFile" class="form-label"></label>
                    <input asp-for="Tour.ImageFile" class="form-control" type="file" accept="image/*" id="imageFile" />
                    <span asp-validation-for="Tour.ImageFile" class="text-danger"></span>
                    <small class="form-text text-muted">Accepted formats: JPG, PNG, GIF (Max size: 5MB)</small>
                </div>

                <div class="mb-3" id="imagePreview" style="display: none;">
                    <label class="form-label">Image Preview</label>
                    <div>
                        <img id="preview" src="#" alt="Preview" class="img-thumbnail" style="max-width: 300px; max-height: 300px;" />
                    </div>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="Tour.IsActive" class="form-check-input" type="checkbox" />
                    <label asp-for="Tour.IsActive" class="form-check-label"></label>
                    <span asp-validation-for="Tour.IsActive" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">Create Tour</button>
                    <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>

        <div class="col-md-4">
            <div class="card bg-light">
                <div class="card-body">
                    <h5 class="card-title">Tips for Creating a Tour</h5>
                    <ul class="small">
                        <li>Use a descriptive and engaging tour name</li>
                        <li>Specify the exact number of days for the tour</li>
                        <li>Set a competitive price</li>
                        <li>List all major locations/attractions</li>
                        <li>Provide detailed tour information</li>
                        <li>Upload an attractive image to showcase the tour</li>
                        <li>Mark the tour as active to make it visible to customers</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Image preview functionality
        document.getElementById('imageFile').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                // Validate file size (5MB max)
                if (file.size > 5242880) {
                    alert('File size must be less than 5MB');
                    e.target.value = '';
                    document.getElementById('imagePreview').style.display = 'none';
                    return;
                }

                // Validate file type
                if (!file.type.match('image.*')) {
                    alert('Please select a valid image file');
                    e.target.value = '';
                    document.getElementById('imagePreview').style.display = 'none';
                    return;
                }

                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('preview').src = e.target.result;
                    document.getElementById('imagePreview').style.display = 'block';
                };
                reader.readAsDataURL(file);
            } else {
                document.getElementById('imagePreview').style.display = 'none';
            }
        });
    </script>
}
