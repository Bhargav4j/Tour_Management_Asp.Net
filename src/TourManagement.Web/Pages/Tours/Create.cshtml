@page
@model TourManagement.Web.Pages.Tours.CreateModel
@{
    ViewData["Title"] = "Create Tour";
}

<h1>Create New Tour</h1>

<hr />

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="row">
    <div class="col-md-6">
        <form method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label asp-for="TourName" class="form-label">Tour Name</label>
                <input asp-for="TourName" class="form-control" required />
            </div>
            <div class="mb-3">
                <label asp-for="Place" class="form-label">Place</label>
                <input asp-for="Place" class="form-control" required />
            </div>
            <div class="mb-3">
                <label asp-for="Days" class="form-label">Days</label>
                <input asp-for="Days" type="number" class="form-control" required />
            </div>
            <div class="mb-3">
                <label asp-for="Price" class="form-label">Price</label>
                <input asp-for="Price" type="number" step="0.01" class="form-control" required />
            </div>
            <div class="mb-3">
                <label asp-for="Locations" class="form-label">Locations</label>
                <input asp-for="Locations" class="form-control" required />
            </div>
            <div class="mb-3">
                <label asp-for="TourInfo" class="form-label">Tour Information</label>
                <textarea asp-for="TourInfo" class="form-control" rows="5" required></textarea>
            </div>
            <div class="mb-3">
                <label asp-for="PictureFile" class="form-label">Picture</label>
                <input asp-for="PictureFile" type="file" class="form-control" accept="image/*" />
            </div>
            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Create</button>
                <a asp-page="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
