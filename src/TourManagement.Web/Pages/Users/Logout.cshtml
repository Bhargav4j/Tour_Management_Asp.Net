@page
@model TourManagement.Web.Pages.Users.LogoutModel
@{
    ViewData["Title"] = "Logout";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-secondary text-white">
                <h2 class="mb-0">Logout</h2>
            </div>
            <div class="card-body text-center py-5">
                <div class="mb-4">
                    <i class="bi bi-box-arrow-right" style="font-size: 4rem; color: #6c757d;"></i>
                </div>
                <h4 class="mb-3">You have been successfully logged out</h4>
                <p class="text-muted mb-4">Thank you for using Tour Management System. Your session has been terminated.</p>

                <div class="d-grid gap-2">
                    <a asp-page="./Login" class="btn btn-primary btn-lg">
                        <i class="bi bi-box-arrow-in-right"></i> Login Again
                    </a>
                    <a asp-page="/Index" class="btn btn-outline-secondary">
                        <i class="bi bi-house"></i> Go to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
