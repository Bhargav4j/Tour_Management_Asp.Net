@page
@model TourManagement.Web.Pages.Users.DeleteModel
@{
    ViewData["Title"] = "Delete User";
}

<div class="container">
    <div class="row mb-4">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
                    <li class="breadcrumb-item"><a asp-page="./Index">Users</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Delete</li>
                </ol>
            </nav>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error:</strong> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.User != null)
    {
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow border-danger">
                    <div class="card-header bg-danger text-white">
                        <h3 class="mb-0">
                            <i class="bi bi-exclamation-triangle"></i> Confirm User Deletion
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-warning" role="alert">
                            <h4 class="alert-heading">
                                <i class="bi bi-exclamation-circle"></i> Warning!
                            </h4>
                            <p class="mb-0">
                                <strong>This action cannot be undone!</strong> Are you sure you want to delete this user account?
                                All associated data will be permanently removed from the system.
                            </p>
                        </div>

                        <h5 class="mt-4 mb-3">User Details</h5>
                        <hr />

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="text-muted small">User ID</label>
                                <p class="fw-bold">@Model.User.Id</p>
                            </div>
                            <div class="col-md-8">
                                <label class="text-muted small">Full Name</label>
                                <p class="fw-bold h5">@Model.User.FullName</p>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="text-muted small">Email Address</label>
                                <p class="fw-bold">@Model.User.Email</p>
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted small">Gender</label>
                                <p class="fw-bold">@Model.User.Gender</p>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="text-muted small">Date of Birth</label>
                                <p class="fw-bold">@Model.User.DateOfBirth.ToString("MMMM dd, yyyy")</p>
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted small">Status</label>
                                <p>
                                    @if (Model.User.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </p>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label class="text-muted small">Address</label>
                                <p class="fw-bold">@Model.User.FullAddress</p>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="text-muted small">Created Date</label>
                                <p class="fw-bold">@Model.User.CreatedDate.ToString("MMMM dd, yyyy")</p>
                            </div>
                            @if (Model.User.ModifiedDate.HasValue)
                            {
                                <div class="col-md-6">
                                    <label class="text-muted small">Last Modified</label>
                                    <p class="fw-bold">@Model.User.ModifiedDate.Value.ToString("MMMM dd, yyyy")</p>
                                </div>
                            }
                        </div>

                        <hr class="my-4" />

                        <form method="post">
                            <input type="hidden" asp-for="User.Id" />

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-danger btn-lg" onclick="return confirm('Are you absolutely sure you want to delete this user? This action CANNOT be undone!');">
                                    <i class="bi bi-trash"></i> Yes, Delete This User
                                </button>
                                <a asp-page="./Details" asp-route-id="@Model.User.Id" class="btn btn-secondary btn-lg">
                                    <i class="bi bi-x-circle"></i> No, Cancel
                                </a>
                                <a asp-page="./Index" class="btn btn-outline-secondary">
                                    <i class="bi bi-arrow-left"></i> Back to User List
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            <h4 class="alert-heading">User Not Found</h4>
            <p class="mb-0">The requested user could not be found.</p>
            <hr />
            <a asp-page="./Index" class="btn btn-primary">Back to User List</a>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Additional client-side validation
        document.querySelector('form').addEventListener('submit', function(e) {
            if (!confirm('FINAL WARNING: This will permanently delete the user account. Continue?')) {
                e.preventDefault();
                return false;
            }
        });
    </script>
}
