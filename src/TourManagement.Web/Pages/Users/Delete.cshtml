@page
@model TourManagement.Web.Pages.Users.DeleteModel
@{
    ViewData["Title"] = "Delete User";
}

<div class="container">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="display-6 text-danger">
                    <i class="bi bi-exclamation-triangle"></i> Delete User
                </h1>
                <a asp-page="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
            </div>

            <div class="alert alert-danger" role="alert">
                <h4 class="alert-heading">
                    <i class="bi bi-exclamation-octagon"></i> Warning!
                </h4>
                <p class="mb-0">
                    You are about to permanently delete this user. This action <strong>cannot be undone</strong>.
                    Please review the user details carefully before proceeding.
                </p>
            </div>

            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-person-x"></i> User to be Deleted
                    </h4>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">
                            <i class="bi bi-hash"></i> User ID
                        </dt>
                        <dd class="col-sm-8">@Model.UserDetails.Id</dd>

                        <dt class="col-sm-4">
                            <i class="bi bi-person"></i> Full Name
                        </dt>
                        <dd class="col-sm-8">@Model.UserDetails.Name</dd>

                        <dt class="col-sm-4">
                            <i class="bi bi-envelope"></i> Email Address
                        </dt>
                        <dd class="col-sm-8">@Model.UserDetails.Email</dd>

                        <dt class="col-sm-4">
                            <i class="bi bi-telephone"></i> Phone Number
                        </dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrEmpty(Model.UserDetails.PhoneNumber))
                            {
                                @Model.UserDetails.PhoneNumber
                            }
                            else
                            {
                                <span class="text-muted">Not provided</span>
                            }
                        </dd>

                        <dt class="col-sm-4">
                            <i class="bi bi-geo-alt"></i> Address
                        </dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrEmpty(Model.UserDetails.Address))
                            {
                                @Model.UserDetails.Address
                            }
                            else
                            {
                                <span class="text-muted">Not provided</span>
                            }
                        </dd>

                        <dt class="col-sm-4">
                            <i class="bi bi-toggle-on"></i> Status
                        </dt>
                        <dd class="col-sm-8">
                            @if (Model.UserDetails.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </dd>

                        <dt class="col-sm-4">
                            <i class="bi bi-calendar-plus"></i> Created Date
                        </dt>
                        <dd class="col-sm-8">
                            @Model.UserDetails.CreatedDate.ToString("MMMM dd, yyyy")
                            <br />
                            <small class="text-muted">Created by: @Model.UserDetails.CreatedBy</small>
                        </dd>

                        <dt class="col-sm-4">
                            <i class="bi bi-calendar-event"></i> Total Bookings
                        </dt>
                        <dd class="col-sm-8">
                            @if (Model.UserDetails.BookingsCount > 0)
                            {
                                <span class="badge bg-warning text-dark">
                                    @Model.UserDetails.BookingsCount Booking(s)
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">0 Bookings</span>
                            }
                        </dd>
                    </dl>

                    @if (Model.UserDetails.BookingsCount > 0)
                    {
                        <div class="alert alert-warning mt-3" role="alert">
                            <i class="bi bi-exclamation-triangle"></i>
                            <strong>Important:</strong> This user has <strong>@Model.UserDetails.BookingsCount</strong> booking(s).
                            You must reassign or delete all bookings before deleting this user.
                        </div>
                    }
                </div>
                <div class="card-footer bg-light">
                    <form method="post">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <a asp-page="Details" asp-route-id="@Model.UserDetails.Id" class="btn btn-secondary">
                                    <i class="bi bi-x-circle"></i> Cancel
                                </a>
                            </div>
                            <div>
                                @if (Model.UserDetails.BookingsCount == 0)
                                {
                                    <button type="submit"
                                            class="btn btn-danger"
                                            onclick="return confirm('Are you absolutely sure you want to delete this user? This action cannot be undone!');">
                                        <i class="bi bi-trash"></i> Confirm Delete
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-danger" disabled>
                                        <i class="bi bi-lock"></i> Cannot Delete (Has Bookings)
                                    </button>
                                }
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <div class="mt-3">
                <a asp-page="Details" asp-route-id="@Model.UserDetails.Id" class="btn btn-link">
                    <i class="bi bi-arrow-left"></i> View User Details Instead
                </a>
            </div>
        </div>
    </div>
</div>
