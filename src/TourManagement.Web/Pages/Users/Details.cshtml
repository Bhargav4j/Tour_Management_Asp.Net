@page
@model TourManagement.Web.Pages.Users.DetailsModel
@{
    ViewData["Title"] = "User Details";
}

<div class="container">
    <div class="row mb-4">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
                    <li class="breadcrumb-item"><a asp-page="./Index">Users</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Details</li>
                </ol>
            </nav>
            <h1 class="display-4">User Details</h1>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error:</strong> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.User != null)
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card shadow mb-4">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0">Personal Information</h4>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="text-muted small">User ID</label>
                                <p class="fw-bold">@Model.User.Id</p>
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted small">Status</label>
                                <p>
                                    @if (Model.User.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </p>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="text-muted small">First Name</label>
                                <p class="fw-bold">@Model.User.FirstName</p>
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted small">Last Name</label>
                                <p class="fw-bold">@Model.User.LastName</p>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="text-muted small">Email Address</label>
                                <p class="fw-bold">@Model.User.Email</p>
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted small">Gender</label>
                                <p class="fw-bold">@Model.User.Gender</p>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="text-muted small">Date of Birth</label>
                                <p class="fw-bold">@Model.User.DateOfBirth.ToString("MMMM dd, yyyy")</p>
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted small">Age</label>
                                <p class="fw-bold">@Model.User.Age years</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card shadow mb-4">
                    <div class="card-header bg-secondary text-white">
                        <h4 class="mb-0">Address Information</h4>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="text-muted small">Street Address</label>
                            <p class="fw-bold">@Model.User.Street</p>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="text-muted small">City</label>
                                <p class="fw-bold">@Model.User.City</p>
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted small">State</label>
                                <p class="fw-bold">@Model.User.State</p>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="text-muted small">Full Address</label>
                            <p class="fw-bold">@Model.User.FullAddress</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow mb-4">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">Actions</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <a asp-page="./Edit" asp-route-id="@Model.User.Id" class="btn btn-warning">
                                <i class="bi bi-pencil"></i> Edit Profile
                            </a>
                            <a asp-page="./Delete" asp-route-id="@Model.User.Id" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Delete User
                            </a>
                            <a asp-page="./Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Back to List
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card shadow">
                    <div class="card-header bg-dark text-white">
                        <h5 class="mb-0">Account Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="text-muted small">Created Date</label>
                            <p class="fw-bold">@Model.User.CreatedDate.ToString("MMMM dd, yyyy")</p>
                            <p class="small text-muted">@Model.User.CreatedDate.ToString("hh:mm tt")</p>
                        </div>

                        @if (Model.User.ModifiedDate.HasValue)
                        {
                            <div class="mb-3">
                                <label class="text-muted small">Last Modified</label>
                                <p class="fw-bold">@Model.User.ModifiedDate.Value.ToString("MMMM dd, yyyy")</p>
                                <p class="small text-muted">@Model.User.ModifiedDate.Value.ToString("hh:mm tt")</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            <h4 class="alert-heading">User Not Found</h4>
            <p class="mb-0">The requested user could not be found.</p>
            <hr />
            <a asp-page="./Index" class="btn btn-primary">Back to User List</a>
        </div>
    }
</div>
