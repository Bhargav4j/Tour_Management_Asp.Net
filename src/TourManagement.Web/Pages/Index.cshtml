@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Tour Management System</h1>
    <p>Discover amazing tours and destinations around the world.</p>

    <div class="mt-4">
        <a asp-page="/Tours/Index" class="btn btn-primary btn-lg">Browse Tours</a>
        @if (User.Identity?.IsAuthenticated != true)
        {
            <a asp-page="/Account/Register" class="btn btn-outline-primary btn-lg">Register Now</a>
        }
    </div>
</div>

<div class="row mt-5">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Explore Destinations</h5>
                <p class="card-text">Browse through our extensive collection of tour packages to amazing destinations.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Easy Booking</h5>
                <p class="card-text">Book your dream tour with just a few clicks. Simple and secure booking process.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Manage Bookings</h5>
                <p class="card-text">View and manage all your bookings from your personal dashboard.</p>
            </div>
        </div>
    </div>
</div>
