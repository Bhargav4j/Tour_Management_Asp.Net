@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Tour Management System</h1>
    <p class="lead">Discover amazing tours and book your next adventure</p>

    <div class="mt-5">
        <a asp-page="/Tours/Index" class="btn btn-primary btn-lg me-3">Browse Tours</a>
        <a asp-page="/Account/Register" class="btn btn-success btn-lg">Sign Up Now</a>
    </div>
</div>

<div class="row mt-5">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center">
                <h3 class="card-title">Browse Tours</h3>
                <p class="card-text">Explore our collection of exciting tour packages to destinations around the world.</p>
                <a asp-page="/Tours/Index" class="btn btn-outline-primary">View Tours</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center">
                <h3 class="card-title">Easy Booking</h3>
                <p class="card-text">Book your tour in just a few clicks with our simple and secure booking system.</p>
                <a asp-page="/Account/Register" class="btn btn-outline-success">Get Started</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center">
                <h3 class="card-title">Manage Bookings</h3>
                <p class="card-text">Track and manage all your bookings from your personal dashboard.</p>
                <a asp-page="/Account/Login" class="btn btn-outline-info">Login</a>
            </div>
        </div>
    </div>
</div>
