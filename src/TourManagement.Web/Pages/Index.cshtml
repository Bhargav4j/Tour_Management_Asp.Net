@page
@model TourManagement.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Home - Tour Management System";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Tour Management System</h1>
    <p class="lead">Explore and book amazing tours around the world</p>
</div>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Browse Tours</h5>
                <p class="card-text">View all available tour packages</p>
                <a asp-page="/Tours/Index" class="btn btn-primary">View Tours</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">User Login</h5>
                <p class="card-text">Login to manage your bookings</p>
                <a asp-page="/Account/Login" class="btn btn-primary">Login</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Register</h5>
                <p class="card-text">Create a new account</p>
                <a asp-page="/Account/Register" class="btn btn-primary">Sign Up</a>
            </div>
        </div>
    </div>
</div>
