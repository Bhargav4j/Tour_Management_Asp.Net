@page
@model TourManagement.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Home - Tour Management";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Tour Management System</h1>
    <p class="lead">Explore amazing tours and destinations</p>
</div>

<div class="row mt-5">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Browse Tours</h5>
                <p class="card-text">Explore our collection of exciting tour packages</p>
                <a asp-page="/Tours/Index" class="btn btn-primary">View Tours</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Sign Up</h5>
                <p class="card-text">Create an account to book your next adventure</p>
                <a asp-page="/Account/Register" class="btn btn-success">Register</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Sign In</h5>
                <p class="card-text">Already have an account? Sign in to manage your bookings</p>
                <a asp-page="/Account/Login" class="btn btn-info">Login</a>
            </div>
        </div>
    </div>
</div>
