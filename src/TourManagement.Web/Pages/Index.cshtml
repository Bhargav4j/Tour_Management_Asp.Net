@page
@model TourManagement.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Tour Management System</h1>
    <p class="lead">Explore amazing tours and book your next adventure!</p>

    <div class="row mt-5">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Browse Tours</h5>
                    <p class="card-text">Discover exciting tour packages to various destinations.</p>
                    <a asp-page="/Tours/Index" class="btn btn-primary">View Tours</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">User Login</h5>
                    <p class="card-text">Login to your account to manage your bookings.</p>
                    <a asp-page="/Users/Login" class="btn btn-primary">Login</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">New User?</h5>
                    <p class="card-text">Register now to start booking tours.</p>
                    <a asp-page="/Users/Register" class="btn btn-primary">Register</a>
                </div>
            </div>
        </div>
    </div>
</div>
