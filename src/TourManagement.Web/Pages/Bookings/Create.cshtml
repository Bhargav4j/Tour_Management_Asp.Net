@page
@model TourManagement.Web.Pages.Bookings.CreateModel
@{
    ViewData["Title"] = "Create Booking";
}

<h1>Create New Booking</h1>

<hr />
<div class="row">
    <div class="col-md-8">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="BookingInput.TourId" class="control-label"></label>
                <select asp-for="BookingInput.TourId" class="form-control" asp-items="Model.TourSelectList">
                    <option value="">-- Select Tour --</option>
                </select>
                <span asp-validation-for="BookingInput.TourId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="BookingInput.Email" class="control-label"></label>
                <input asp-for="BookingInput.Email" class="form-control" />
                <span asp-validation-for="BookingInput.Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="BookingInput.FirstName" class="control-label"></label>
                <input asp-for="BookingInput.FirstName" class="form-control" />
                <span asp-validation-for="BookingInput.FirstName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">Create Booking</button>
                <a asp-page="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            $('#BookingInput_TourId').change(function() {
                var selectedTourId = $(this).val();
                if (selectedTourId) {
                    // You can add AJAX call here to fetch tour details if needed
                }
            });
        });
    </script>
}
