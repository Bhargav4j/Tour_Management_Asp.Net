@page
@model TourManagement.Web.Pages.Bookings.CreateModel
@{
    ViewData["Title"] = "Create Booking";
}

<div class="container">
    <h1>Create New Booking</h1>

    <form method="post">
        <div class="mb-3">
            <label asp-for="Input.UserId" class="form-label"></label>
            <select asp-for="Input.UserId" class="form-select">
                <option value="">Select User</option>
                @foreach (var user in Model.Users)
                {
                    <option value="@user.Id">@user.FirstName @user.LastName - @user.Email</option>
                }
            </select>
            <span asp-validation-for="Input.UserId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.TourId" class="form-label"></label>
            <select asp-for="Input.TourId" class="form-select">
                <option value="">Select Tour</option>
                @foreach (var tour in Model.Tours)
                {
                    <option value="@tour.Id">@tour.TourName - @tour.Place (@tour.Price.ToString("C"))</option>
                }
            </select>
            <span asp-validation-for="Input.TourId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.BookingDate" class="form-label"></label>
            <input asp-for="Input.BookingDate" class="form-control" type="date" />
            <span asp-validation-for="Input.BookingDate" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.NumberOfPeople" class="form-label"></label>
            <input asp-for="Input.NumberOfPeople" class="form-control" type="number" min="1" />
            <span asp-validation-for="Input.NumberOfPeople" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.TotalAmount" class="form-label"></label>
            <input asp-for="Input.TotalAmount" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="Input.TotalAmount" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-page="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
