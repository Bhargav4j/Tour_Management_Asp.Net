@page
@model CreateBookingModel
@{
    ViewData["Title"] = "Book Tour";
}

<h2>@ViewData["Title"]</h2>

@if (Model.Tour == null)
{
    <div class="alert alert-warning">Tour not found.</div>
    <a asp-page="/Tours/Index" class="btn btn-secondary">Back to Tours</a>
}
else
{
    <div class="row">
        <div class="col-md-6">
            <div class="card mb-3">
                @if (!string.IsNullOrEmpty(Model.Tour.Pic))
                {
                    <img src="~/images/tours/@Model.Tour.Pic" class="card-img-top" alt="@Model.Tour.TourName" style="max-height: 300px; object-fit: cover;" />
                }
                <div class="card-body">
                    <h5 class="card-title">@Model.Tour.TourName</h5>
                    <p class="card-text">
                        <strong>Place:</strong> @Model.Tour.Place<br />
                        <strong>Duration:</strong> @Model.Tour.Days days<br />
                        <strong>Price per person:</strong> $@Model.Tour.Price.ToString("N2")
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <form method="post">
                <div asp-validation-summary="All" class="text-danger"></div>

                <input type="hidden" asp-for="TourId" />

                <div class="form-group mb-3">
                    <label asp-for="NumberOfPeople" class="form-label"></label>
                    <input asp-for="NumberOfPeople" class="form-control" type="number" min="1" max="10" />
                    <span asp-validation-for="NumberOfPeople" class="text-danger"></span>
                </div>

                @if (Model.NumberOfPeople > 0)
                {
                    <div class="alert alert-info">
                        <strong>Total Amount:</strong> $@((Model.Tour.Price * Model.NumberOfPeople).ToString("N2"))
                    </div>
                }

                <div class="form-group mb-3">
                    <button type="submit" class="btn btn-success">Confirm Booking</button>
                    <a asp-page="/Tours/Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
