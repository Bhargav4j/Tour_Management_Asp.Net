@page
@model TourManagement.Web.Pages.Bookings.MyBookingsModel
@{
    ViewData["Title"] = "My Bookings";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="display-4">My Bookings</h1>
            @if (!string.IsNullOrEmpty(Model.UserName))
            {
                <p class="text-muted">Welcome, @Model.UserName</p>
            }
        </div>
        <div class="col-md-4 text-end">
            <a asp-page="/Tours/Index" class="btn btn-primary">
                <i class="bi bi-search"></i> Browse Tours
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.Bookings.Any())
    {
        <div class="row">
            @foreach (var booking in Model.Bookings)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card shadow-sm h-100">
                        @if (!string.IsNullOrEmpty(booking.TourPictureFileName))
                        {
                            <img src="~/images/tours/@booking.TourPictureFileName" class="card-img-top" alt="@booking.TourName" style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                                <span class="text-white">No Image</span>
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@booking.TourName</h5>
                            <p class="card-text">
                                <small class="text-muted">
                                    <i class="bi bi-geo-alt"></i> @booking.TourPlace
                                    <br />
                                    <i class="bi bi-calendar"></i> @booking.TourDays Days
                                </small>
                            </p>

                            <hr />

                            <div class="mb-2">
                                <strong>Booking Date:</strong> @booking.BookingDate.ToString("MMM dd, yyyy")
                            </div>
                            <div class="mb-2">
                                <strong>People:</strong> @booking.NumberOfPeople
                            </div>
                            <div class="mb-2">
                                <strong>Total Amount:</strong>
                                <span class="text-success fs-5">$@booking.TotalAmount.ToString("N2")</span>
                            </div>
                            <div class="mb-3">
                                <strong>Status:</strong>
                                @if (booking.Status == "Confirmed")
                                {
                                    <span class="badge bg-success">@booking.Status</span>
                                }
                                else if (booking.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">@booking.Status</span>
                                }
                                else if (booking.Status == "Cancelled")
                                {
                                    <span class="badge bg-danger">@booking.Status</span>
                                }
                                else if (booking.Status == "Completed")
                                {
                                    <span class="badge bg-info">@booking.Status</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@booking.Status</span>
                                }
                            </div>

                            <div class="mt-auto">
                                <div class="btn-group w-100" role="group">
                                    <a asp-page="./Details" asp-route-id="@booking.Id" class="btn btn-sm btn-outline-info">
                                        Details
                                    </a>
                                    @if (booking.Status != "Cancelled" && booking.Status != "Completed")
                                    {
                                        <a asp-page="./Edit" asp-route-id="@booking.Id" class="btn btn-sm btn-outline-warning">
                                            Edit
                                        </a>
                                        <a asp-page="./Delete" asp-route-id="@booking.Id" class="btn btn-sm btn-outline-danger">
                                            Cancel
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="card-footer text-muted">
                            <small>Booked on @booking.CreatedDate.ToString("MMM dd, yyyy")</small>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Booking Statistics -->
        <div class="row mt-4">
            <div class="col-md-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Booking Summary</h5>
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-md-3">
                                <h3>@Model.Bookings.Count</h3>
                                <p class="text-muted">Total Bookings</p>
                            </div>
                            <div class="col-md-3">
                                <h3>@Model.Bookings.Count(b => b.Status == "Confirmed")</h3>
                                <p class="text-muted">Confirmed</p>
                            </div>
                            <div class="col-md-3">
                                <h3>@Model.Bookings.Count(b => b.Status == "Pending")</h3>
                                <p class="text-muted">Pending</p>
                            </div>
                            <div class="col-md-3">
                                <h3>$@Model.Bookings.Where(b => b.Status != "Cancelled").Sum(b => b.TotalAmount).ToString("N2")</h3>
                                <p class="text-muted">Total Spent</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <h4 class="alert-heading">No Bookings Yet</h4>
            <p>You haven't made any bookings yet. Browse our amazing tours and book your next adventure!</p>
            <hr>
            <p class="mb-0">
                <a asp-page="/Tours/Index" class="btn btn-primary">Browse Available Tours</a>
            </p>
        </div>
    }
</div>
