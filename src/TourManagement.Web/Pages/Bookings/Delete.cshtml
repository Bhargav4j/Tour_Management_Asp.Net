@page "{id:int}"
@model TourManagement.Web.Pages.Bookings.DeleteModel
@{
    ViewData["Title"] = "Delete Booking";
}

<h1>@ViewData["Title"]</h1>

<h3>Are you sure you want to delete this booking?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Booking ID</dt>
        <dd class="col-sm-10">@Model.Booking?.Id</dd>

        <dt class="col-sm-2">Tour Name</dt>
        <dd class="col-sm-10">@Model.Booking?.TourName</dd>

        <dt class="col-sm-2">Place</dt>
        <dd class="col-sm-10">@Model.Booking?.Place</dd>

        <dt class="col-sm-2">Customer Name</dt>
        <dd class="col-sm-10">@Model.Booking?.FirstName</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Booking?.Email</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Booking!.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
