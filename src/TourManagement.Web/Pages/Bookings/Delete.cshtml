@page "{id:int}"
@model TourManagement.Web.Pages.Bookings.DeleteModel
@{
    ViewData["Title"] = "Delete Booking";
}

<div class="container">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="display-4 text-danger">Delete Booking</h1>
            <p class="lead">Are you sure you want to delete this booking?</p>
        </div>
    </div>

    @if (Model.Booking == null)
    {
        <div class="alert alert-warning" role="alert">
            <h4 class="alert-heading">Booking Not Found</h4>
            <p>The booking you are trying to delete does not exist or has already been deleted.</p>
            <hr>
            <a asp-page="Index" class="btn btn-primary">Back to Bookings List</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-8 offset-md-2">
                <div class="alert alert-danger" role="alert">
                    <h4 class="alert-heading">Warning!</h4>
                    <p>This action cannot be undone. Please review the booking details below before confirming deletion.</p>
                </div>

                <div class="card shadow-sm border-danger">
                    <div class="card-header bg-danger text-white">
                        <h5 class="mb-0">Booking Details - ID: @Model.Booking.Id</h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <h6 class="border-bottom pb-2 mb-3">Customer Information</h6>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="fw-bold text-muted">First Name:</label>
                                <p class="fs-6">@Model.Booking.FirstName</p>
                            </div>
                            <div class="col-md-6">
                                <label class="fw-bold text-muted">Email:</label>
                                <p class="fs-6">@Model.Booking.Email</p>
                            </div>
                        </div>

                        @if (Model.Booking.UserId.HasValue)
                        {
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="fw-bold text-muted">User ID:</label>
                                    <p class="fs-6">@Model.Booking.UserId</p>
                                </div>
                            </div>
                        }

                        <div class="row mb-3">
                            <div class="col-md-12">
                                <h6 class="border-bottom pb-2 mb-3">Tour Information</h6>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="fw-bold text-muted">Tour Name:</label>
                                <p class="fs-6">@Model.Booking.TourName</p>
                            </div>
                            <div class="col-md-6">
                                <label class="fw-bold text-muted">Place:</label>
                                <p class="fs-6">@Model.Booking.Place</p>
                            </div>
                        </div>

                        @if (Model.Booking.TourId.HasValue)
                        {
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="fw-bold text-muted">Tour ID:</label>
                                    <p class="fs-6">@Model.Booking.TourId</p>
                                </div>
                            </div>
                        }

                        <div class="row mb-3">
                            <div class="col-md-12">
                                <h6 class="border-bottom pb-2 mb-3">Booking Details</h6>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="fw-bold text-muted">Booking Date:</label>
                                <p class="fs-6">@Model.Booking.BookingDate.ToString("MMMM dd, yyyy")</p>
                            </div>
                            <div class="col-md-6">
                                <label class="fw-bold text-muted">Status:</label>
                                <p class="fs-6">
                                    @if (Model.Booking.Status == "Confirmed")
                                    {
                                        <span class="badge bg-success">@Model.Booking.Status</span>
                                    }
                                    else if (Model.Booking.Status == "Cancelled")
                                    {
                                        <span class="badge bg-danger">@Model.Booking.Status</span>
                                    }
                                    else if (Model.Booking.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">@Model.Booking.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@Model.Booking.Status</span>
                                    }
                                </p>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="fw-bold text-muted">Created Date:</label>
                                <p class="fs-6">@Model.Booking.CreatedDate.ToString("MMMM dd, yyyy HH:mm")</p>
                            </div>
                            <div class="col-md-6">
                                <label class="fw-bold text-muted">Active:</label>
                                <p class="fs-6">
                                    @if (Model.Booking.IsActive)
                                    {
                                        <span class="badge bg-success">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No</span>
                                    }
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-light">
                        <form method="post">
                            <input type="hidden" asp-for="Booking.Id" />
                            <div class="d-flex justify-content-between align-items-center">
                                <a asp-page="Details" asp-route-id="@Model.Booking.Id" class="btn btn-secondary">
                                    Cancel
                                </a>
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-trash"></i> Confirm Delete
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
