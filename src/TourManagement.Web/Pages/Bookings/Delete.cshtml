@page
@model TourManagement.Web.Pages.Bookings.DeleteModel
@{
    ViewData["Title"] = "Delete Booking";
}

<div class="container">
    <h1>Delete Booking</h1>
    <h3 class="text-danger">Are you sure you want to delete this booking?</h3>

    @if (Model.Booking != null)
    {
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Booking #@Model.Booking.Id</h5>
                <dl class="row">
                    <dt class="col-sm-3">User</dt>
                    <dd class="col-sm-9">@Model.Booking.UserName</dd>

                    <dt class="col-sm-3">Tour</dt>
                    <dd class="col-sm-9">@Model.Booking.TourName</dd>

                    <dt class="col-sm-3">Booking Date</dt>
                    <dd class="col-sm-9">@Model.Booking.BookingDate.ToString("d")</dd>

                    <dt class="col-sm-3">Total Amount</dt>
                    <dd class="col-sm-9">@Model.Booking.TotalAmount.ToString("C")</dd>
                </dl>

                <form method="post">
                    <input type="hidden" asp-for="Booking.Id" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">Booking not found.</div>
        <a asp-page="Index" class="btn btn-secondary">Back to List</a>
    }
</div>
