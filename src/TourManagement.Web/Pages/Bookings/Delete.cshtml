@page
@model TourManagement.Web.Pages.Bookings.DeleteModel
@{
    ViewData["Title"] = "Cancel Booking";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h2 class="mb-0">Cancel Booking</h2>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @Model.ErrorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <div class="alert alert-warning">
                        <h4 class="alert-heading">Warning!</h4>
                        <p>Are you sure you want to cancel this booking? This action cannot be undone.</p>
                    </div>

                    <form method="post">
                        <input type="hidden" asp-for="Booking.Id" />

                        <div class="card mb-3">
                            <div class="card-header bg-light">
                                <h5 class="mb-0">Booking Information</h5>
                            </div>
                            <div class="card-body">
                                <dl class="row mb-0">
                                    <dt class="col-sm-4">Booking ID:</dt>
                                    <dd class="col-sm-8">@Model.Booking.Id</dd>

                                    <dt class="col-sm-4">Tour Name:</dt>
                                    <dd class="col-sm-8"><strong>@Model.Booking.TourName</strong></dd>

                                    <dt class="col-sm-4">Place:</dt>
                                    <dd class="col-sm-8">@Model.Booking.TourPlace</dd>

                                    <dt class="col-sm-4">Duration:</dt>
                                    <dd class="col-sm-8">@Model.Booking.TourDays Days</dd>

                                    <dt class="col-sm-4">Price per Person:</dt>
                                    <dd class="col-sm-8">$@Model.Booking.TourPrice.ToString("N2")</dd>
                                </dl>
                            </div>
                        </div>

                        <div class="card mb-3">
                            <div class="card-header bg-light">
                                <h5 class="mb-0">Customer Information</h5>
                            </div>
                            <div class="card-body">
                                <dl class="row mb-0">
                                    <dt class="col-sm-4">Customer Name:</dt>
                                    <dd class="col-sm-8">@Model.Booking.UserName</dd>

                                    <dt class="col-sm-4">Email:</dt>
                                    <dd class="col-sm-8">@Model.Booking.UserEmail</dd>
                                </dl>
                            </div>
                        </div>

                        <div class="card mb-3">
                            <div class="card-header bg-light">
                                <h5 class="mb-0">Booking Details</h5>
                            </div>
                            <div class="card-body">
                                <dl class="row mb-0">
                                    <dt class="col-sm-4">Booking Date:</dt>
                                    <dd class="col-sm-8">@Model.Booking.BookingDate.ToString("MMMM dd, yyyy")</dd>

                                    <dt class="col-sm-4">Number of People:</dt>
                                    <dd class="col-sm-8">@Model.Booking.NumberOfPeople</dd>

                                    <dt class="col-sm-4">Total Amount:</dt>
                                    <dd class="col-sm-8">
                                        <strong class="text-danger">$@Model.Booking.TotalAmount.ToString("N2")</strong>
                                    </dd>

                                    <dt class="col-sm-4">Status:</dt>
                                    <dd class="col-sm-8">
                                        @if (Model.Booking.Status == "Confirmed")
                                        {
                                            <span class="badge bg-success">@Model.Booking.Status</span>
                                        }
                                        else if (Model.Booking.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">@Model.Booking.Status</span>
                                        }
                                        else if (Model.Booking.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger">@Model.Booking.Status</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@Model.Booking.Status</span>
                                        }
                                    </dd>

                                    <dt class="col-sm-4">Created Date:</dt>
                                    <dd class="col-sm-8">@Model.Booking.CreatedDate.ToString("MMMM dd, yyyy hh:mm tt")</dd>

                                    <dt class="col-sm-4">Active:</dt>
                                    <dd class="col-sm-8">
                                        @if (Model.Booking.IsActive)
                                        {
                                            <span class="badge bg-success">Yes</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">No</span>
                                        }
                                    </dd>
                                </dl>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-between mt-4">
                            <a asp-page="./Index" class="btn btn-secondary btn-lg">
                                No, Keep Booking
                            </a>
                            <button type="submit" class="btn btn-danger btn-lg">
                                Yes, Cancel Booking
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
