@page
@model TourManagement.Web.Pages.Bookings.DetailsModel
@{
    ViewData["Title"] = "Booking Details";
}

<h2>Booking Details</h2>

@if (Model.Booking != null)
{
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Booking #@Model.Booking.BookingId</h5>
            <p class="card-text"><strong>Tour:</strong> @Model.Booking.TourName</p>
            <p class="card-text"><strong>Place:</strong> @Model.Booking.Place</p>
            <p class="card-text"><strong>Customer:</strong> @Model.Booking.FirstName</p>
            <p class="card-text"><strong>Email:</strong> @Model.Booking.Email</p>
            <p class="card-text"><strong>Booking Date:</strong> @Model.Booking.BookingDate.ToShortDateString()</p>
        </div>
    </div>
    <div class="mt-3">
        <a asp-page="/Bookings/Delete" asp-route-id="@Model.Booking.BookingId" class="btn btn-danger">Cancel Booking</a>
        <a asp-page="/Bookings/MyBookings" class="btn btn-secondary">Back to My Bookings</a>
    </div>
}
else
{
    <p>Booking not found.</p>
}
