@page "{id:int}"
@model TourManagement.Web.Pages.Bookings.DetailsModel
@{
    ViewData["Title"] = "Booking Details";
}

<h1>Booking Details</h1>

<div>
    <hr />
    @if (Model.Booking != null)
    {
        <dl class="row">
            <dt class="col-sm-3">Booking ID</dt>
            <dd class="col-sm-9">@Model.Booking.BookingId</dd>

            <dt class="col-sm-3">Tour Name</dt>
            <dd class="col-sm-9">@Model.Booking.TourName</dd>

            <dt class="col-sm-3">Place</dt>
            <dd class="col-sm-9">@Model.Booking.Place</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Booking.Email</dd>

            <dt class="col-sm-3">First Name</dt>
            <dd class="col-sm-9">@Model.Booking.FirstName</dd>

            <dt class="col-sm-3">Booking Date</dt>
            <dd class="col-sm-9">@Model.Booking.CreatedDate.ToString("MMM dd, yyyy HH:mm")</dd>

            @if (Model.Booking.Tour != null)
            {
                <dt class="col-sm-3">Tour Details</dt>
                <dd class="col-sm-9">
                    <strong>Days:</strong> @Model.Booking.Tour.Days<br />
                    <strong>Price:</strong> $@Model.Booking.Tour.Price<br />
                    <strong>Locations:</strong> @Model.Booking.Tour.Locations
                </dd>
            }
        </dl>

        <div class="mt-3">
            <a asp-page="/Tours/Details" asp-route-id="@Model.Booking.TourId" class="btn btn-info">View Tour</a>
            <a asp-page="./Delete" asp-route-id="@Model.Booking.BookingId" class="btn btn-danger">Cancel Booking</a>
            <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            Booking not found.
        </div>
        <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
    }
</div>
