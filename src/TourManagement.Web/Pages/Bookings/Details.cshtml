@page "{id:int}"
@model TourManagement.Web.Pages.Bookings.DetailsModel
@{
    ViewData["Title"] = "Booking Details";
}

<h1>@ViewData["Title"]</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Booking ID</dt>
        <dd class="col-sm-10">@Model.Booking?.Id</dd>

        <dt class="col-sm-2">Tour Name</dt>
        <dd class="col-sm-10">@Model.Booking?.TourName</dd>

        <dt class="col-sm-2">Place</dt>
        <dd class="col-sm-10">@Model.Booking?.Place</dd>

        <dt class="col-sm-2">Customer Name</dt>
        <dd class="col-sm-10">@Model.Booking?.FirstName</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Booking?.Email</dd>

        <dt class="col-sm-2">Booking Date</dt>
        <dd class="col-sm-10">@Model.Booking?.BookingDate.ToString("yyyy-MM-dd HH:mm")</dd>
    </dl>
</div>
<div>
    <a asp-page="Edit" asp-route-id="@Model.Booking?.Id" class="btn btn-primary">Edit</a>
    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
</div>
