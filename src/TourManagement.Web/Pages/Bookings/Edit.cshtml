@page
@model TourManagement.Web.Pages.Bookings.EditModel
@{
    ViewData["Title"] = "Edit Booking";
}

<div class="container">
    <h1>Edit Booking</h1>

    <form method="post">
        <input type="hidden" asp-for="Input.Id" />

        <div class="mb-3">
            <label>User</label>
            <input type="text" class="form-control" value="@Model.UserName" readonly />
        </div>

        <div class="mb-3">
            <label>Tour</label>
            <input type="text" class="form-control" value="@Model.TourName" readonly />
        </div>

        <div class="mb-3">
            <label asp-for="Input.BookingDate" class="form-label"></label>
            <input asp-for="Input.BookingDate" class="form-control" type="date" />
            <span asp-validation-for="Input.BookingDate" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.NumberOfPeople" class="form-label"></label>
            <input asp-for="Input.NumberOfPeople" class="form-control" type="number" min="1" />
            <span asp-validation-for="Input.NumberOfPeople" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.TotalAmount" class="form-label"></label>
            <input asp-for="Input.TotalAmount" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="Input.TotalAmount" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Status" class="form-label"></label>
            <select asp-for="Input.Status" class="form-select">
                <option value="Pending">Pending</option>
                <option value="Confirmed">Confirmed</option>
                <option value="Cancelled">Cancelled</option>
                <option value="Completed">Completed</option>
            </select>
            <span asp-validation-for="Input.Status" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <button type="submit" class="btn btn-primary">Update</button>
            <a asp-page="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
