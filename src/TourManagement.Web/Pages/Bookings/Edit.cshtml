@page "{id:int}"
@model TourManagement.Web.Pages.Bookings.EditModel
@{
    ViewData["Title"] = "Edit Booking";
}

<h1>@ViewData["Title"]</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="BookingInput.Id" />

            <div class="form-group mb-3">
                <label asp-for="BookingInput.TourName" class="control-label"></label>
                <input asp-for="BookingInput.TourName" class="form-control" />
                <span asp-validation-for="BookingInput.TourName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="BookingInput.Place" class="control-label"></label>
                <input asp-for="BookingInput.Place" class="form-control" />
                <span asp-validation-for="BookingInput.Place" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="BookingInput.Email" class="control-label"></label>
                <input asp-for="BookingInput.Email" class="form-control" type="email" />
                <span asp-validation-for="BookingInput.Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="BookingInput.FirstName" class="control-label"></label>
                <input asp-for="BookingInput.FirstName" class="form-control" />
                <span asp-validation-for="BookingInput.FirstName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-page="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
