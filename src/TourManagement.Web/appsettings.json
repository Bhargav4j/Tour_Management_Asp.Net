{
  "_comments": {
    "EnvironmentVariables": "Configuration values can be overridden using environment variables.",
    "DatabaseSettings": "Use DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD environment variables",
    "Redis": "Use REDIS_CONNECTION environment variable for distributed session storage",
    "Docker": "See appsettings.Docker.json for container configuration examples"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=tourmanagementdb;Username=postgres;Password=postgres;Include Error Detail=true"
  },
  "DatabaseSettings": {
    "Host": "localhost",
    "Port": "5432",
    "Database": "tourmanagementdb",
    "Username": "postgres",
    "Password": "postgres"
  },
  "Redis": {
    "Connection": ""
  },
  "FileStorage": {
    "Type": "local",
    "BasePath": "uploads/Tour_pics"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*"
}
