@page
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@model BookingsIndexModel
@{
    ViewData["Title"] = "My Bookings";
}

<h2>My Bookings</h2>

@if (Model.Bookings != null && Model.Bookings.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Tour Name</th>
                <th>Place</th>
                <th>Booking Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model.Bookings)
            {
                <tr>
                    <td>@booking.TourName</td>
                    <td>@booking.Place</td>
                    <td>@booking.BookingDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        <a asp-page="/Bookings/Details" asp-route-id="@booking.Id" class="btn btn-sm btn-info">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>You have no bookings yet.</p>
    <a asp-page="/Tours/Index" class="btn btn-primary">Browse Tours</a>
}
