@page
@model ToursIndexModel
@{
    ViewData["Title"] = "Tours";
}

<h2>Available Tours</h2>

@if (!string.IsNullOrEmpty(Model.SearchTerm))
{
    <p>Search results for: <strong>@Model.SearchTerm</strong></p>
}

<div class="row mb-3">
    <div class="col-md-6">
        <form method="get" class="d-flex">
            <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control me-2" placeholder="Search tours..." />
            <button type="submit" class="btn btn-primary">Search</button>
        </form>
    </div>
</div>

@if (Model.Tours != null && Model.Tours.Any())
{
    <div class="row">
        @foreach (var tour in Model.Tours)
        {
            <div class="col-md-4 mb-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">@tour.Name</h5>
                        <p class="card-text">
                            <strong>Place:</strong> @tour.Place<br />
                            <strong>Days:</strong> @tour.Days<br />
                            <strong>Price:</strong> $@tour.Price
                        </p>
                        <a asp-page="/Tours/Details" asp-route-id="@tour.Id" class="btn btn-primary">View Details</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p>No tours available.</p>
}
